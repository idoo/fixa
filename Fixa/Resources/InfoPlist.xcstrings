    "NSCameraUsageDescription" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Fixa الكاميرا لتتمكن من التقاط صورة للمشكلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa používá fotoaparát, abyste mohli problém vyfotit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa bruger kameraet, så du kan tage et billede af problemet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa verwendet die Kamera, damit Sie ein Foto vom Problem machen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fixa χρησιμοποιεί την κάμερα για να μπορείτε να φωτογραφίσετε το πρόβλημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa uses the camera so you can take a photo of the problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa usa la cámara para que puedas hacer una foto del problema."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa kasutab kaamerat, et saaksite probleemist foto teha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa käyttää kameraa, jotta voit ottaa kuvan ongelmasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa utilise l'appareil photo pour que vous puissiez photographier le problème."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa a kamerát használja, hogy fényképet készíthessen a problémáról."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa usa la fotocamera per permetterti di fotografare il problema."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa naudoja kamerą, kad galėtumėte nufotografuoti problemą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa izmanto kameru, lai jūs varētu nofotografēt problēmu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa bruker kameraet slik at du kan ta et bilde av problemet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa gebruikt de camera zodat je een foto van het probleem kunt maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa używa aparatu, aby można było zrobić zdjęcie problemu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa usa a câmara para que possa tirar uma fotografia do problema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa folosește camera ca să puteți fotografia problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa использует камеру, чтобы вы могли сфотографировать проблему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa använder kameran så att du kan ta en bild av problemet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa використовує камеру, щоб ви могли сфотографувати проблему."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Fixa موقعك لوضع الدبوس في مكان المشكلة: عند الضغط على «استخدم موقعي الحالي»، وفي البلاغ الجديد بعد أن تسمح بذلك. لا يُرسل موقعك إلا مع بلاغ ترسله أنت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa používá vaši polohu k umístění špendlíku na místo závady: když klepnete na Použít mou aktuální polohu, a u nového hlášení, jakmile polohu povolíte. Poloha se odešle jen s hlášením, které odešlete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa bruger din placering til at sætte nålen, hvor problemet er: når du trykker på Brug min nuværende placering, og på en ny anmeldelse, når du har givet adgang. Placeringen sendes kun med en anmeldelse, du sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa verwendet Ihren Standort, um die Stecknadel dort zu setzen, wo das Problem ist: wenn Sie auf „Aktuellen Standort verwenden“ tippen, und bei einer neuen Meldung, sobald Sie es erlaubt haben. Der Standort wird nur mit einer Meldung gesendet, die Sie absenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fixa χρησιμοποιεί την τοποθεσία σας για να βάλει την πινέζα εκεί που είναι το πρόβλημα: όταν πατάτε «Χρήση της τρέχουσας τοποθεσίας μου» και σε νέα αναφορά αφού το επιτρέψετε. Η θέση σας στέλνεται μόνο με αναφορά που στέλνετε εσείς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa uses your location to put the pin where the problem is: when you tap Use my current location, and on a new report once you have allowed it. Your position is only sent with a report you send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa usa su ubicación para poner el marcador donde está el problema: cuando toca Usar mi ubicación actual y en un aviso nuevo una vez que lo ha permitido. Su posición solo se envía con un aviso que usted envíe."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa kasutab sinu asukohta, et panna nööpnõel probleemi kohale: kui puudutad nuppu Kasuta minu praegust asukohta ja uue teate puhul, kui oled selle lubanud. Asukoht saadetakse ainult koos teatega, mille sa saadad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa käyttää sijaintiasi asettaakseen nuppineulan vian kohdalle: kun napautat Käytä nykyistä sijaintiani, ja uudessa ilmoituksessa, kun olet sallinut sen. Sijainti lähetetään vain lähettämäsi ilmoituksen mukana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa utilise votre position pour placer l'épingle là où se trouve le problème : quand vous touchez Utiliser ma position actuelle, et sur un nouveau signalement une fois que vous l'avez autorisé. Votre position n'est envoyée qu'avec un signalement que vous envoyez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa a helyzetét arra használja, hogy oda tegye a tűt, ahol a hiba van: amikor a Jelenlegi helyzetem gombra koppint, és új bejelentésnél, ha már engedélyezte. A helyzete csak az Ön által elküldött bejelentéssel megy el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa usa la tua posizione per mettere il segnaposto dove si trova il problema: quando tocchi Usa la mia posizione attuale e in una nuova segnalazione dopo che l'hai consentito. La posizione viene inviata solo con una segnalazione che invii tu."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa naudoja jūsų vietą, kad padėtų smeigtuką ten, kur yra problema: kai paliečiate Naudoti mano dabartinę vietą, ir naujame pranešime, kai tai leidote. Vieta siunčiama tik su jūsų siunčiamu pranešimu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa izmanto jūsu atrašanās vietu, lai novietotu adatu problēmas vietā: kad pieskaraties Izmantot manu pašreizējo atrašanās vietu, un jaunā ziņojumā, kad esat to atļāvis. Atrašanās vieta tiek nosūtīta tikai ar ziņojumu, ko nosūtāt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa bruker posisjonen din til å sette nålen der problemet er: når du trykker på Bruk min posisjon, og på en ny melding når du har gitt tillatelse. Posisjonen sendes bare med en melding du sender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa gebruikt uw locatie om de speld te zetten waar het probleem is: als u op Gebruik mijn huidige locatie tikt, en bij een nieuwe melding zodra u het hebt toegestaan. Uw positie wordt alleen meegestuurd met een melding die u verstuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa używa Twojej lokalizacji, by postawić pinezkę tam, gdzie jest usterka: gdy stukniesz Użyj mojej bieżącej lokalizacji, oraz w nowym zgłoszeniu, gdy już na to pozwolisz. Pozycja jest wysyłana tylko ze zgłoszeniem, które wyślesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa usa a sua localização para pôr o pino onde está o problema: quando toca em Usar a minha localização atual e numa nova participação depois de o permitir. A posição só é enviada com uma participação que envie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa folosește locația dvs. pentru a pune pinul unde este problema: când atingeți Folosiți locația mea actuală și la o sesizare nouă, după ce ați permis. Poziția se trimite doar cu o sesizare pe care o trimiteți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa использует вашу геопозицию, чтобы поставить метку там, где проблема: когда вы нажимаете «Использовать мою геопозицию», а также в новой заявке, если доступ уже разрешён. Геопозиция отправляется только с заявкой, которую вы отправите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa använder din plats för att sätta nålen där felet är: när du trycker på Använd min nuvarande plats, och på en ny anmälan när du har gett lov. Positionen skickas bara med en anmälan du skickar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa використовує ваше місцезнаходження, щоб поставити мітку там, де проблема: коли ви натискаєте «Використати моє поточне місцезнаходження», а також у новому зверненні, якщо доступ уже дозволено. Місцезнаходження надсилається лише зі зверненням, яке ви надішлете."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لك Fixa اختيار صور للمشكلة لإرفاقها ببلاغك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve Fixe můžete vybrat fotky problému a přiložit je k hlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Fixa kan du vælge billeder af problemet og vedhæfte dem din anmeldelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Fixa können Sie Fotos vom Problem auswählen und Ihrer Meldung beifügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με το Fixa μπορείτε να επιλέξετε φωτογραφίες του προβλήματος και να τις επισυνάψετε στην αναφορά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa lets you pick photos of the problem to attach to your report."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa te permite elegir fotos del problema para adjuntarlas a tu aviso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa abil saate valida probleemi fotod ja lisada need teatele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixalla voit valita kuvia ongelmasta ja liittää ne ilmoitukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa vous permet de choisir des photos du problème à joindre à votre signalement."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixával fényképeket választhat a problémáról, és csatolhatja őket a bejelentéshez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Fixa puoi scegliere foto del problema da allegare alla segnalazione."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa leidžia pasirinkti problemos nuotraukas ir pridėti jas prie pranešimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa ļauj izvēlēties problēmas fotoattēlus, ko pievienot ziņojumam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Fixa kan du velge bilder av problemet og legge dem ved meldingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Fixa kun je foto's van het probleem kiezen en aan je melding toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W aplikacji Fixa możesz wybrać zdjęcia problemu i dołączyć je do zgłoszenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa permite-lhe escolher fotografias do problema para anexar à sua participação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cu Fixa puteți alege fotografii ale problemei pe care să le atașați la sesizare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Fixa можно выбрать фото проблемы и прикрепить их к заявке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Fixa kan du välja bilder på problemet och bifoga dem i anmälan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Fixa можна вибрати фото проблеми й додати їх до звернення."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
