    "Turn on Precise Location in Settings, or move the map yourself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الموقع الدقيق في الإعدادات، أو حرّك الخريطة بنفسك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte Přesnou polohu v Nastavení, nebo posuňte mapu sami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Præcis lokalitet til i Indstillinger, eller flyt selv kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie „Genauer Standort“ in den Einstellungen oder verschieben Sie die Karte selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε την Ακριβή τοποθεσία στις Ρυθμίσεις ή μετακινήστε τον χάρτη μόνοι σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Precise Location in Settings, or move the map yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Ubicación exacta en Ajustes o mueve el mapa manualmente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lülitage seadetes sisse Täpne asukoht või liigutage kaarti ise."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita Tarkka sijainti päälle Asetuksissa tai siirrä karttaa itse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Position exacte dans Réglages, ou déplacez la carte vous-même."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be a Pontos helyzetet a Beállításokban, vagy mozgassa a térképet saját maga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Posizione esatta in Impostazioni, oppure sposta tu la mappa."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nustatymuose įjunkite „Tiksli vieta“ arba patys pastumkite žemėlapį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieslēdziet iestatījumos opciju Precīza atrašanās vieta vai pārvietojiet karti paši."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Nøyaktig posisjon i Innstillinger, eller flytt kartet selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Nauwkeurige locatie aan in Instellingen, of verschuif de kaart zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Dokładną lokalizację w Ustawieniach albo przesuń mapę samodzielnie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a Localização exata nas Definições ou mova o mapa manualmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați Localizare exactă în Configurări sau mutați singur harta."
          }
        },
        "ru" : {
          "stringUnit" : {
