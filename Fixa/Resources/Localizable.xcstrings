    "Fixa adds this Swedish summary so the municipality understands." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف Fixa هذا الملخص بالسويدية لكي تفهمه البلدية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa přidá toto shrnutí ve švédštině, aby mu obec rozuměla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa tilføjer dette resumé på svensk, så kommunen forstår det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa fügt diese schwedische Zusammenfassung hinzu, damit die Gemeinde sie versteht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fixa προσθέτει αυτή την περίληψη στα σουηδικά, ώστε να την καταλαβαίνει ο δήμος."
          }
