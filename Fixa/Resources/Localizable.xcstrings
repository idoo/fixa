        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa можна закрити. Звернення буде в розділі «Надіслані звернення»."
          }
        }
      }
    },
    "You can delete everything in Settings. To change or remove a report you've already sent, contact %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك حذف كل شيء من الإعدادات. لتعديل بلاغ أرسلته أو سحبه، تواصل مع %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechno můžete smazat v Nastavení. Chcete-li změnit nebo odstranit už odeslané hlášení, obraťte se na %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slette alt under Indstillinger. Vil du ændre eller fjerne en anmeldelse, du allerede har sendt, så kontakt %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst alles in den Einstellungen löschen. Um eine bereits gesendete Meldung zu ändern oder zu löschen, wende dich an %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείς να τα διαγράψεις όλα στις Ρυθμίσεις. Για να αλλάξεις ή να αφαιρέσεις μια αναφορά που έχεις ήδη στείλει, επικοινώνησε με %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can delete everything in Settings. To change or remove a report you've already sent, contact %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes borrarlo todo en Ajustes. Para cambiar o eliminar un aviso ya enviado, contacta con %@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik saad kustutada seadetes. Juba saadetud teate muutmiseks või kustutamiseks võta ühendust: %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit poistaa kaiken asetuksista. Jos haluat muuttaa tai poistaa jo lähetetyn ilmoituksen, ota yhteyttä: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez tout effacer dans Réglages. Pour modifier ou supprimer un signalement déjà envoyé, contactez %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindent törölhetsz a Beállításokban. Egy már elküldött bejelentés módosításához vagy törléséhez fordulj ide: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cancellare tutto in Impostazioni. Per modificare o eliminare una segnalazione già inviata, contatta %@."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viską galite ištrinti nustatymuose. Norėdami pakeisti ar pašalinti jau išsiųstą pranešimą, kreipkitės į %@."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visu vari izdzēst iestatījumos. Lai mainītu vai dzēstu jau nosūtītu ziņojumu, sazinies ar %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slette alt under Innstillinger. Vil du endre eller fjerne en melding du allerede har sendt, kontakt %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt alles wissen bij Instellingen. Wil je een verstuurde melding wijzigen of verwijderen, neem dan contact op met %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko usuniesz w Ustawieniach. Aby zmienić lub usunąć wysłane już zgłoszenie, skontaktuj się z: %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode apagar tudo nas Definições. Para alterar ou remover uma participação já enviada, contacte %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poți șterge tot din Setări. Ca să modifici sau să retragi o sesizare deja trimisă, contactează %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё можно удалить в Настройках. Чтобы изменить или отозвать уже отправленную заявку, свяжитесь с %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan radera allt under Inställningar. Vill du ändra eller ta bort en anmälan du redan skickat, kontakta %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе можна видалити в Налаштуваннях. Щоб змінити або відкликати вже надіслану заявку, зверніться до %@."
          }
        }
      }
    },
    "You've sent many reports in a short time. Try again at %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلت بلاغات كثيرة في وقت قصير. حاول مجددًا في %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za krátkou dobu jste poslali hodně hlášení. Zkuste to znovu v %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har sendt mange anmeldelser på kort tid. Prøv igen kl. %@."
          }
        },
        "de" : {
          "stringUnit" : {
