          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepovinné. Použije se jen tehdy, když požádáte o odpověď. Uloženo v tomto telefonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit. Bruges kun, når du beder om svar. Gemmes på denne telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Wird nur verwendet, wenn Sie eine Antwort wünschen. Auf diesem Telefon gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προαιρετικό. Χρησιμοποιείται μόνο όταν ζητάτε απάντηση. Αποθηκεύεται σε αυτό το τηλέφωνο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Only used when you ask for a reply. Saved on this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Solo se usa si pides respuesta. Se guarda en este teléfono."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valikuline. Kasutatakse ainult siis, kui soovite vastust. Salvestatakse sellesse telefoni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapaaehtoinen. Käytetään vain, kun pyydät vastausta. Tallennetaan tähän puhelimeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Utilisé seulement si vous demandez une réponse. Enregistré sur ce téléphone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem kötelező. Csak akkor használjuk, ha választ kér. Ezen a telefonon tárolódik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Usato solo se chiedi una risposta. Salvato su questo telefono."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neprivaloma. Naudojama tik tada, kai prašote atsakymo. Išsaugoma šiame telefone."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav obligāti. Tiek izmantots tikai tad, ja lūdzat atbildi. Saglabāts šajā tālrunī."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt. Brukes bare når du ber om svar. Lagres på denne telefonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Wordt alleen gebruikt als je om een antwoord vraagt. Bewaard op deze telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne. Używane tylko, gdy prosisz o odpowiedź. Zapisane na tym telefonie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Só é usado quando pede uma resposta. Guardado neste telemóvel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opțional. Folosit doar când cereți un răspuns. Salvat pe acest telefon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Используется только если вы хотите получить ответ. Хранится на этом телефоне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frivilligt. Används bara när du vill ha svar. Sparas i telefonen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необов’язково. Використовується, лише коли ви просите відповідь. Зберігається на цьому телефоні."
          }
        }
      }
    },
