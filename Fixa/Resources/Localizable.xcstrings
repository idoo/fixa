    "Fixa tried a few times and couldn't get it through. Try again now, or copy the text and e-mail it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول Fixa عدة مرات ولم ينجح في الإرسال. حاول مرة أخرى الآن، أو انسخ النص وأرسله بالبريد الإلكتروني."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa to zkusila několikrát a nepodařilo se. Zkuste to znovu, nebo text zkopírujte a pošlete e-mailem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa prøvede nogle gange, men kunne ikke få den igennem. Prøv igen nu, eller kopiér teksten og send den på e-mail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa hat es mehrmals versucht, aber die Meldung kam nicht durch. Versuchen Sie es jetzt erneut, oder kopieren Sie den Text und senden Sie ihn per E-Mail."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fixa δοκίμασε μερικές φορές χωρίς επιτυχία. Δοκιμάστε ξανά τώρα ή αντιγράψτε το κείμενο και στείλτε το με email."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa tried a few times and couldn't get it through. Try again now, or copy the text and e-mail it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa lo intentó varias veces y no consiguió enviarlo. Vuelve a intentarlo ahora, o copia el texto y envíalo por correo electrónico."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa proovis mitu korda, kuid teade ei läinud läbi. Proovige kohe uuesti või kopeerige tekst ja saatke see e-postiga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa yritti muutaman kerran, mutta lähetys ei onnistunut. Yritä nyt uudelleen tai kopioi teksti ja lähetä se sähköpostilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa a essayé plusieurs fois sans y parvenir. Réessayez maintenant, ou copiez le texte et envoyez-le par e-mail."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa többször próbálkozott, de nem sikerült elküldeni. Próbálja újra most, vagy másolja ki a szöveget, és küldje el e-mailben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa ha provato alcune volte senza riuscirci. Riprova ora, oppure copia il testo e invialo via e-mail."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa bandė kelis kartus, bet nepavyko išsiųsti. Bandykite dar kartą dabar arba nukopijuokite tekstą ir išsiųskite jį el. paštu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa mēģināja vairākas reizes, taču ziņojumu neizdevās nosūtīt. Mēģiniet vēlreiz tagad vai nokopējiet tekstu un nosūtiet to pa e-pastu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa prøvde noen ganger, men kom ikke gjennom. Prøv igjen nå, eller kopier teksten og send den på e-post."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa heeft het een paar keer geprobeerd, maar het lukte niet. Probeer het nu opnieuw, of kopieer de tekst en stuur hem per e-mail."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa próbował kilka razy, ale nie udało się wysłać. Spróbuj ponownie teraz albo skopiuj tekst i wyślij go e-mailem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa tentou várias vezes e não conseguiu enviá-la. Tente novamente agora ou copie o texto e envie-o por e-mail."
