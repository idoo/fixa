    "Fixa reached the last step and stopped. Nothing was submitted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa reached the last step and stopped. Nothing was submitted."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa kom till sista steget och stannade. Inget skickades."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa pääsi viimeiseen vaiheeseen ja pysähtyi. Mitään ei lähetetty."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل Fixa إلى الخطوة الأخيرة وتوقف. لم يُرسَل شيء."
