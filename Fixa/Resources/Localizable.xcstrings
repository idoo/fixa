          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas pazudīs no sadaļas Nosūtītie ziņojumi lietotnē Fixa. Pats ziņojums paliek pie %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forsvinner fra Sendte meldinger i Fixa. Selve meldingen blir værende hos %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De melding verdwijnt uit Verstuurde meldingen in Fixa. De melding zelf blijft bij %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zniknie z wysłanych zgłoszeń w Fixie. Samo zgłoszenie zostaje w: %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparece das Participações enviadas na Fixa. A participação em si continua em %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispare din Sesizări trimise în Fixa. Sesizarea propriu-zisă rămâne la %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она исчезнет из раздела «Отправленные заявки» в Fixa. Сама заявка останется в %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den försvinner från Skickade anmälningar i Fixa. Själva anmälan finns kvar hos %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воно зникне з надісланих звернень у Fixa. Саме звернення залишиться в %@."
          }
        }
      }
    },
    "It may already have arrived. Sending it again can create a second case at %@ for the same problem." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما وصل بالفعل. إعادة الإرسال قد تفتح لدى %@ حالة ثانية للمشكلة نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možná už dorazilo. Opětovné odeslání může u %@ založit druhý případ ke stejné závadě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er måske allerede kommet frem. Sender du den igen, kan %@ få en ekstra sag om det samme problem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist vielleicht schon angekommen. Erneutes Senden kann bei %@ einen zweiten Fall zum selben Problem anlegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ίσως έχει ήδη φτάσει. Αν το στείλετε ξανά, μπορεί να ανοίξει δεύτερη υπόθεση για το ίδιο πρόβλημα: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may already have arrived. Sending it again can create a second case at %@ for the same problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que ya haya llegado. Si lo envía otra vez, %@ puede abrir un segundo caso por el mismo problema."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See võib juba kohale jõudnud olla. Uuesti saatmine võib luua %@ juures samale probleemile teise juhtumi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on voinut jo mennä perille. Uudelleen lähettäminen voi luoda samasta viasta toisen asian: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est peut-être déjà arrivé. Le renvoyer peut créer un second dossier chez %@ pour le même problème."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehet, hogy már megérkezett. Ha újra elküldi, %@ második ügyet nyithat ugyanarra a hibára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe essere già arrivata. Inviarla di nuovo può creare una seconda pratica presso %@ per lo stesso problema."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jis galbūt jau gautas. Išsiuntus dar kartą, %@ gali užregistruoti antrą bylą dėl tos pačios problemos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas, iespējams, jau ir saņemts. Nosūtot vēlreiz, %@ var izveidot otru lietu par to pašu problēmu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kan allerede ha kommet frem. Sender du den igjen, kan %@ få en ekstra sak om det samme problemet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij is misschien al aangekomen. Opnieuw versturen kan bij %@ een tweede zaak voor hetzelfde probleem opleveren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogło już dotrzeć. Ponowne wysłanie może utworzyć w %@ drugą sprawę dotyczącą tej samej usterki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode já ter chegado. Enviar de novo pode criar um segundo processo em %@ para o mesmo problema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este posibil să fi ajuns deja. Dacă îl trimiteți din nou, %@ poate deschide un al doilea dosar pentru aceeași problemă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, оно уже дошло. Повторная отправка может создать в %@ второе обращение по той же проблеме."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kan redan ha kommit fram. Skickar du igen kan %@ få ett andra ärende om samma fel."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, воно вже дійшло. Повторне надсилання може створити в %@ друге звернення щодо тієї самої проблеми."
          }
        }
      }
    },
