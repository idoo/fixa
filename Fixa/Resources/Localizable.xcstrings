    "Nothing is sent until you press Send." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُرسل شيء حتى تضغط على «إرسال»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic se neodešle, dokud neklepnete na Odeslat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet sendes, før du trykker på Send."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wird gesendet, bevor Sie auf Senden tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίποτα δεν στέλνεται μέχρι να πατήσετε Αποστολή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is sent until you press Send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envía nada hasta que pulse Enviar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midagi ei saadeta enne, kui vajutad Saada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään ei lähetetä ennen kuin painat Lähetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'est envoyé tant que vous n'appuyez pas sur Envoyer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semmi nem megy el, amíg meg nem nyomja a Küldés gombot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non viene inviato nulla finché non tocchi Invia."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niekas neišsiunčiama, kol nepaspausite Siųsti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekas netiek nosūtīts, kamēr nenospiežat Sūtīt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting sendes før du trykker på Send."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt niets verstuurd tot u op Verstuur tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie zostanie wysłane, dopóki nie naciśniesz Wyślij."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é enviado até tocar em Enviar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu se trimite nimic până nu apăsați Trimite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не отправляется, пока вы не нажмёте «Отправить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget skickas förrän du trycker på Skicka."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нічого не надсилається, доки ви не натиснете «Надіслати»."
          }
        }
      }
    },
