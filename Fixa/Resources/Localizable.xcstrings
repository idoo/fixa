    "Optional. Only used when you ask for a reply, for the report you're writing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختياري. تُستخدم فقط عندما تطلب ردًا، للبلاغ الذي تكتبه الآن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepovinné. Použije se jen tehdy, když požádáte o odpověď, a to pro hlášení, které právě píšete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit. Bruges kun, når du beder om svar, til den anmeldelse, du skriver nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Wird nur verwendet, wenn Sie eine Antwort wünschen, und nur für die aktuelle Meldung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προαιρετικό. Χρησιμοποιείται μόνο όταν ζητάτε απάντηση, για την αναφορά που γράφετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Only used when you ask for a reply, for the report you're writing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Solo se usa si pides respuesta, para el aviso que estás escribiendo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valikuline. Kasutatakse ainult siis, kui soovite vastust, praegu kirjutatava teate jaoks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapaaehtoinen. Käytetään vain, kun pyydät vastausta, nyt kirjoittamaasi ilmoitukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Utilisé seulement si vous demandez une réponse, pour le signalement en cours."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem kötelező. Csak akkor használjuk, ha választ kér, és csak az éppen írt bejelentéshez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Usato solo se chiedi una risposta, per la segnalazione che stai scrivendo."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neprivaloma. Naudojama tik tada, kai prašote atsakymo, rašomam pranešimui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav obligāti. Tiek izmantots tikai tad, ja lūdzat atbildi uz ziņojumu, ko pašlaik rakstāt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt. Brukes bare når du ber om svar, for meldingen du skriver nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Wordt alleen gebruikt als je om een antwoord vraagt, voor de melding die je nu schrijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne. Używane tylko, gdy prosisz o odpowiedź, w zgłoszeniu, które piszesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Só é usado quando pede uma resposta, para a participação que está a escrever."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opțional. Folosit doar când cereți un răspuns, pentru sesizarea pe care o scrieți acum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Используется только если вы хотите получить ответ, и только для этой заявки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
