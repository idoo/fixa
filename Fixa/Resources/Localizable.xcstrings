    "The street light by the bus stop has been out since Monday." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The street light by the bus stop has been out since Monday."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatlampan vid busshållplatsen har varit släckt sedan i måndags."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bussipysäkin katuvalo on ollut pimeänä maanantaista asti."
