    "The street light by the bus stop has been out since Monday." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The street light by the bus stop has been out since Monday."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatlampan vid busshållplatsen har varit släckt sedan i måndags."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bussipysäkin katuvalo on ollut pimeänä maanantaista asti."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصباح الشارع عند موقف الحافلات مطفأ منذ يوم الاثنين."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ліхтар біля автобусної зупинки не світить з понеділка."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latarnia przy przystanku nie świeci od poniedziałku."
          }
        }
      }
    },
    "The street light by the bus stop has been out since Monday. It is very dark there in the evening." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The street light by the bus stop has been out since Monday. It is very dark there in the evening."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatlampan vid busshållplatsen har varit släckt sedan i måndags. Det är väldigt mörkt där på kvällen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bussipysäkin katuvalo on ollut pimeänä maanantaista asti. Siellä on illalla todella pimeää."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصباح الشارع عند موقف الحافلات مطفأ منذ يوم الاثنين. المكان مظلم جدًا في المساء."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ліхтар біля автобусної зупинки не світить з понеділка. Увечері там дуже темно."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latarnia przy przystanku nie świeci od poniedziałku. Wieczorem jest tam bardzo ciemno."
          }
        }
      }
    },
    "They pass it to the right team and reply by e-mail." : {
