            "value" : "Olet lähettänyt monta ilmoitusta lyhyessä ajassa. Yritä uudelleen %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as envoyé beaucoup de signalements en peu de temps. Réessaie à %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rövid idő alatt sok bejelentést küldtél. Próbáld újra ekkor: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
