    "Fixa won't send it, and it disappears from Sent reports." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يرسله Fixa، وسيختفي من البلاغات المرسلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa ho neodešle a hlášení zmizí ze seznamu Odeslaná hlášení."
