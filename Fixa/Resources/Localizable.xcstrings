    "Värmdö kommun's e-service isn't taking reports from Fixa right now. Use the kommun's website." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värmdö kommun's e-service isn't taking reports from Fixa right now. Use the kommun's website."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värmdö kommuns e-tjänst tar inte emot anmälningar från Fixa just nu. Använd kommunens webbplats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-služba obce Värmdö teď nepřijímá hlášení z Fixy. Použijte web obce."
