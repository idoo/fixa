    "Sent reports (type, text, place, small photo, case number): on this phone until you delete them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البلاغات المُرسلة (النوع، النص، المكان، صورة صغيرة، رقم القضية): على هذا الهاتف حتى تحذفها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odeslaná hlášení (typ, text, místo, malá fotka, číslo případu): v tomto telefonu, dokud je nesmažete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendte anmeldelser (type, tekst, sted, lille billede, sagsnummer): på denne telefon, indtil du sletter dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesendete Meldungen (Art, Text, Ort, kleines Foto, Vorgangsnummer): auf diesem Telefon, bis Sie sie löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απεσταλμένες αναφορές (τύπος, κείμενο, τοποθεσία, μικρή φωτογραφία, αριθμός υπόθεσης): σε αυτό το τηλέφωνο μέχρι να τις διαγράψετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent reports (type, text, place, small photo, case number): on this phone until you delete them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisos enviados (tipo, texto, lugar, foto pequeña, número de caso): en este teléfono hasta que los elimines."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saadetud teated (liik, tekst, koht, väike foto, menetlusnumber): selles telefonis, kuni te need kustutate."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetetyt ilmoitukset (tyyppi, teksti, paikka, pieni kuva, asianumero): tässä puhelimessa, kunnes poistat ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signalements envoyés (type, texte, lieu, petite photo, numéro de dossier) : sur ce téléphone jusqu’à ce que vous les supprimiez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elküldött bejelentések (típus, szöveg, hely, kis fénykép, ügyszám): ezen a telefonon maradnak, amíg nem törli őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnalazioni inviate (tipo, testo, luogo, foto piccola, numero della pratica): su questo telefono finché non le elimini."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išsiųsti pranešimai (tipas, tekstas, vieta, maža nuotrauka, bylos numeris): šiame telefone, kol juos ištrinsite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosūtītie ziņojumi (veids, teksts, vieta, mazs fotoattēls, lietas numurs): šajā tālrunī, līdz jūs tos izdzēšat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendte meldinger (type, tekst, sted, lite bilde, saksnummer): på denne telefonen til du sletter dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuurde meldingen (soort, tekst, plek, kleine foto, zaaknummer): op deze telefoon tot je ze verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłane zgłoszenia (rodzaj, tekst, miejsce, małe zdjęcie, numer sprawy): na tym telefonie, dopóki ich nie usuniesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participações enviadas (tipo, texto, local, fotografia pequena, número do processo): neste telemóvel até as eliminar."
          }
        },
        "ro" : {
          "stringUnit" : {
