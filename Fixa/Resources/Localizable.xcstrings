    "The e-service didn't answer. Your report is saved on this phone, and Fixa tries again in a little while." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تستجب الخدمة الإلكترونية. بلاغك محفوظ على هذا الهاتف، وسيحاول Fixa مرة أخرى بعد قليل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-služba neodpověděla. Vaše hlášení je uložené v tomto telefonu a Fixa to za chvíli zkusí znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
