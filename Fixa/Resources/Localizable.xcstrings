          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparece de Avisos enviados en Fixa. El aviso en sí sigue en manos de %@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See kaob Fixas saadetud teadete hulgast. Teade ise jääb alles: %@."
