    "Fixa only sends reports to %@. Search for the address of the problem, or move the map." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل Fixa البلاغات إلى %@ فقط. ابحث عن عنوان المشكلة أو حرّك الخريطة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa posílá hlášení pouze pro %@. Vyhledejte adresu, kde je problém, nebo posuňte mapu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa sender kun anmeldelser til %@. Søg efter adressen, hvor problemet er, eller flyt kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa sendet Meldungen nur an %@. Suchen Sie die Adresse des Problems oder verschieben Sie die Karte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fixa στέλνει αναφορές μόνο στο %@. Αναζητήστε τη διεύθυνση του προβλήματος ή μετακινήστε τον χάρτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa only sends reports to %@. Search for the address of the problem, or move the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa solo envía avisos a %@. Busca la dirección del problema o mueve el mapa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa saadab teateid ainult: %@. Otsige probleemi aadressi või liigutage kaarti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa lähettää ilmoitukset vain kohteeseen %@. Hae ongelman osoite tai siirrä karttaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa envoie les signalements uniquement à %@. Recherchez l’adresse du problème ou déplacez la carte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa csak ide küld bejelentéseket: %@. Keressen rá a probléma címére, vagy mozgassa a térképet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa invia segnalazioni solo a %@. Cerca l'indirizzo del problema o sposta la mappa."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa siunčia pranešimus tik į %@. Ieškokite problemos vietos adreso arba pastumkite žemėlapį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa sūta ziņojumus tikai uz %@. Meklējiet problēmas vietas adresi vai pārvietojiet karti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa sender bare meldinger til %@. Søk etter adressen der problemet er, eller flytt kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa stuurt alleen meldingen naar %@. Zoek het adres van het probleem of verschuif de kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa wysyła zgłoszenia tylko do: %@. Wyszukaj adres problemu albo przesuń mapę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa só envia participações para %@. Procure a morada do problema ou mova o mapa."
