    "The street light by the bus stop has been out since Monday." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصباح الشارع عند موقف الحافلات مطفأ منذ يوم الاثنين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouliční lampa u autobusové zastávky nesvítí od pondělí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gadelampen ved busstoppestedet har været slukket siden mandag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Straßenlaterne an der Bushaltestelle ist seit Montag aus."
