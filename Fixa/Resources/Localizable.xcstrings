    "You can close Fixa. You'll find the report under Sent reports." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إغلاق Fixa. ستجد البلاغ في البلاغات المرسلة."
          }
        },
        "cs" : {
          "stringUnit" : {
