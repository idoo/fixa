  "strings" : {
    "%lld reports are removed from this phone, with their case numbers. %@ still has them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد البلاغات التي ستُحذف من هذا الهاتف مع أرقام قضاياها: %lld. تبقى لدى %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld hlášení se z tohoto telefonu odstraní i s čísly případů. %@ je má stále k dispozici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal anmeldelser, der fjernes fra denne telefon sammen med deres sagsnumre: %lld. %@ har dem stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Meldungen werden mit ihren Vorgangsnummern von diesem Telefon entfernt. %@ hat sie weiterhin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld αναφορές αφαιρούνται από αυτό το τηλέφωνο, μαζί με τους αριθμούς υπόθεσής τους. Το %@ εξακολουθεί να τις έχει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld reports are removed from this phone, with their case numbers. %@ still has them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan %lld avisos de este teléfono, con sus números de caso. %@ los sigue teniendo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld teadet eemaldatakse sellest telefonist koos menetlusnumbritega. %@ säilitab need."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ilmoitusta poistetaan tästä puhelimesta asianumeroineen. %@ säilyttää ne."
