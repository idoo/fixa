    "Your details, settings and sent reports are included in your iPhone backup. Unsent photos are not." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بياناتك وإعداداتك والبلاغات المرسلة مشمولة في النسخة الاحتياطية لجهاز iPhone. الصور غير المرسلة غير مشمولة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše údaje, nastavení a odeslaná hlášení jsou součástí zálohy vašeho iPhonu. Neodeslané fotky ne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine oplysninger, indstillinger og sendte anmeldelser er med i sikkerhedskopien af din iPhone. Billeder, der ikke er sendt, er ikke med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Kontaktdaten, Einstellungen und gesendeten Meldungen sind im Backup Ihres iPhone enthalten. Noch nicht gesendete Fotos nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα στοιχεία σας, οι ρυθμίσεις και οι απεσταλμένες αναφορές περιλαμβάνονται στο αντίγραφο ασφαλείας του iPhone σας. Οι φωτογραφίες που δεν έχουν σταλεί δεν περιλαμβάνονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your details, settings and sent reports are included in your iPhone backup. Unsent photos are not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos, ajustes y avisos enviados se incluyen en la copia de seguridad de tu iPhone. Las fotos no enviadas no se incluyen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie andmed, seaded ja saadetud teated on teie iPhone'i varukoopias. Saatmata fotod ei ole."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietosi, asetuksesi ja lähetetyt ilmoitukset sisältyvät iPhonen varmuuskopioon. Lähettämättömät kuvat eivät sisälly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos coordonnées, vos réglages et vos signalements envoyés sont inclus dans la sauvegarde de votre iPhone. Les photos non envoyées ne le sont pas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adatai, beállításai és elküldött bejelentései bekerülnek az iPhone biztonsági mentésébe. A még el nem küldött fényképek nem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati, le impostazioni e le segnalazioni inviate sono inclusi nel backup dell'iPhone. Le foto non inviate no."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų duomenys, nustatymai ir išsiųsti pranešimai įtraukiami į iPhone atsarginę kopiją. Neišsiųstos nuotraukos neįtraukiamos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu dati, iestatījumi un nosūtītie ziņojumi tiek iekļauti iPhone dublējumkopijā. Nenosūtītie fotoattēli netiek iekļauti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opplysningene, innstillingene og de sendte meldingene dine er med i iPhone-sikkerhetskopien din. Bilder som ikke er sendt, er ikke med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens, instellingen en verstuurde meldingen zitten in de reservekopie van je iPhone. Niet-verstuurde foto's niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje dane, ustawienia i wysłane zgłoszenia są w kopii zapasowej iPhone’a. Niewysłane zdjęcia nie są."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dados, definições e participações enviadas estão incluídos na cópia de segurança do seu iPhone. As fotografias não enviadas não estão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele, setările și sesizările trimise sunt incluse în backupul iPhone-ului dumneavoastră. Fotografiile netrimise nu sunt incluse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные, настройки и отправленные заявки входят в резервную копию iPhone. Неотправленные фото в неё не входят."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina uppgifter, inställningar och skickade anmälningar ingår i säkerhetskopian av din iPhone. Foton som inte har skickats ingår inte."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші дані, налаштування та надіслані звернення входять до резервної копії iPhone. Ненадіслані фото не входять."
          }
        }
      }
    },
    "Your e-mail, name and phone are removed from this phone, and new reports won't ask for a reply. Reports you already sent keep them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف بريدك الإلكتروني واسمك ورقم هاتفك من هذا الهاتف، ولن تطلب البلاغات الجديدة ردًا. أما البلاغات التي أرسلتها بالفعل فتبقى كما هي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš e-mail, jméno a telefon budou z tohoto telefonu odstraněny a nová hlášení nebudou žádat o odpověď. Již odeslaná hlášení si je ponechají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din e-mail, dit navn og dit telefonnummer fjernes fra denne telefon, og nye anmeldelser beder ikke om svar. Anmeldelser, du allerede har sendt, beholder dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre E-Mail-Adresse, Ihr Name und Ihre Telefonnummer werden von diesem Telefon entfernt, und neue Meldungen fordern keine Antwort an. Bereits gesendete Meldungen behalten diese Angaben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το email, το όνομα και το τηλέφωνό σας αφαιρούνται από αυτό το τηλέφωνο και οι νέες αναφορές δεν θα ζητούν απάντηση. Οι αναφορές που έχετε ήδη στείλει τα διατηρούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your e-mail, name and phone are removed from this phone, and new reports won't ask for a reply. Reports you already sent keep them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu correo electrónico, nombre y teléfono se eliminan de este teléfono, y los nuevos avisos no pedirán respuesta. Los avisos que ya enviaste los conservan."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie e-post, nimi ja telefoninumber eemaldatakse sellest telefonist ning uutes teadetes vastust ei küsita. Juba saadetud teadetes jäävad need alles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sähköpostisi, nimesi ja puhelinnumerosi poistetaan tästä puhelimesta, eivätkä uudet ilmoitukset pyydä vastausta. Jo lähettämäsi ilmoitukset säilyttävät ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre e-mail, votre nom et votre numéro de téléphone sont supprimés de ce téléphone, et les nouveaux signalements ne demanderont pas de réponse. Les signalements déjà envoyés les conservent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az e-mail-címe, a neve és a telefonszáma törlődik erről a telefonról, és az új bejelentésekhez nem kér választ. A már elküldött bejelentésekben ezek megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mail, nome e telefono vengono rimossi da questo telefono e le nuove segnalazioni non chiederanno una risposta. Le segnalazioni già inviate li mantengono."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų el. paštas, vardas ir telefono numeris pašalinami iš šio telefono, o nauji pranešimai neprašys atsakymo. Jau išsiųstuose pranešimuose jie išlieka."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu e-pasts, vārds un tālruņa numurs tiks dzēsti no šī tālruņa, un jaunajos ziņojumos atbilde netiks pieprasīta. Jau nosūtītajos ziņojumos tie saglabāsies."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-postadressen, navnet og telefonnummeret ditt fjernes fra denne telefonen, og nye meldinger ber ikke om svar. Meldinger du allerede har sendt, beholder dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je e-mailadres, naam en telefoonnummer worden van deze telefoon verwijderd, en bij nieuwe meldingen wordt niet om een antwoord gevraagd. Meldingen die je al hebt verstuurd, behouden ze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój e-mail, imię i telefon zostaną usunięte z tego telefonu, a nowe zgłoszenia nie będą prosić o odpowiedź. Wysłane już zgłoszenia je zachowają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu e-mail, nome e telefone são removidos deste telemóvel e as novas participações não pedirão resposta. As participações já enviadas mantêm-nos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mailul, numele și telefonul dumneavoastră sunt șterse de pe acest telefon, iar sesizările noi nu vor cere răspuns. Sesizările deja trimise le păstrează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши адрес электронной почты, имя и телефон будут удалены с этого телефона, а в новых заявках не будет запроса ответа. В уже отправленных заявках они сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din e-post, ditt namn och telefonnummer tas bort från telefonen, och nya anmälningar ber inte om svar. Anmälningar du redan skickat behåller dem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашу електронну пошту, ім’я і телефон буде видалено з цього телефона, а нові звернення не проситимуть відповіді. Уже надіслані звернення їх збережуть."
          }
        }
      }
    },
    "Your iPhone shares only an approximate location" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشارك iPhone موقعًا تقريبيًا فقط"
