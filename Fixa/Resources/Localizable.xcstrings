    "Once in a while Fixa downloads an updated description of the municipality's form from GitHub. Nothing about you is sent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنزّل Fixa من حين لآخر وصفًا محدّثًا لنموذج البلدية من GitHub. لا يُرسل أي شيء عنك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa občas stáhne z GitHubu aktualizovaný popis formuláře obce. Nic o vás se neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gang imellem henter Fixa en opdateret beskrivelse af kommunens formular fra GitHub. Intet om dig bliver sendt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab und zu lädt Fixa eine aktuelle Beschreibung des Formulars der Gemeinde von GitHub. Dabei wird nichts über Sie gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατά διαστήματα το Fixa κατεβάζει από το GitHub μια ενημερωμένη περιγραφή της φόρμας του δήμου. Δεν αποστέλλεται τίποτα για εσάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once in a while Fixa downloads an updated description of the municipality's form from GitHub. Nothing about you is sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vez en cuando, Fixa descarga de GitHub una descripción actualizada del formulario del municipio. No se envía nada sobre ti."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aeg-ajalt laadib Fixa GitHubist alla omavalitsuse vormi uuendatud kirjelduse. Teie kohta midagi ei saadeta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silloin tällöin Fixa lataa GitHubista päivitetyn kuvauksen kunnan lomakkeesta. Sinusta ei lähetetä mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De temps en temps, Fixa télécharge depuis GitHub une description à jour du formulaire de la commune. Aucune information vous concernant n'est envoyée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa időnként letölti a GitHubról az önkormányzat űrlapjának frissített leírását. Önről semmilyen adat nem kerül elküldésre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tanto Fixa scarica da GitHub una descrizione aggiornata del modulo del comune. Non viene inviato nulla su di te."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retkarčiais Fixa atsisiunčia atnaujintą savivaldybės formos aprašą iš GitHub. Jokie duomenys apie jus nesiunčiami."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laiku pa laikam Fixa lejupielādē no GitHub atjauninātu pašvaldības veidlapas aprakstu. Nekas par jums netiek nosūtīts."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av og til laster Fixa ned en oppdatert beskrivelse av kommunens skjema fra GitHub. Ingenting om deg blir sendt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
