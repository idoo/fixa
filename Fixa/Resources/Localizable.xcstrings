        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld bejelentés törlődik erről a telefonról, az ügyszámukkal együtt. A(z) %@ továbbra is megőrzi őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld segnalazioni vengono rimosse da questo telefono, con i relativi numeri delle pratiche. %@ le conserva ancora."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iš šio telefono pašalinama pranešimų: %lld, kartu su jų bylų numeriais. %@ juos vis tiek turi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No šī tālruņa tiek dzēsti %lld ziņojumi kopā ar to lietu numuriem. %@ tie joprojām ir saglabāti."
