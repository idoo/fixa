    "Your report is saved on this phone. Fixa isn't sending on its own right now. Open Sent reports to use the kommun's website instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report is saved on this phone. Fixa isn't sending on its own right now. Open Sent reports to use the kommun's website instead."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din anmälan är sparad i telefonen. Fixa skickar inte av sig själv just nu. Öppna Skickade anmälningar för att använda kommunens webbplats i stället."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlášení je uložené v telefonu. Fixa ho teď sama neodešle. Otevřete Odeslaná hlášení a použijte místo toho web obce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din indberetning er gemt på telefonen. Fixa sender ikke af sig selv lige nu. Åbn Sendte indberetninger for at bruge kommunens hjemmeside i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Meldung ist auf diesem Telefon gespeichert. Fixa sendet gerade nicht von selbst. Öffnen Sie Gesendete Meldungen, um stattdessen die Website der Gemeinde zu nutzen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie teade on telefoni salvestatud. Fixa ei saada praegu ise. Avage Saadetud teated, et kasutada selle asemel valla veebisaiti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu aviso está guardado en este teléfono. Fixa no lo envía por su cuenta ahora mismo. Abre Avisos enviados para usar la web del municipio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre signalement est enregistré sur ce téléphone. Fixa n'envoie rien de lui-même pour le moment. Ouvrez Signalements envoyés pour passer par le site de la commune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La segnalazione è salvata su questo telefono. Al momento Fixa non invia da solo. Apri Segnalazioni inviate per usare invece il sito del comune."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu ziņojums ir saglabāts tālrunī. Fixa pašlaik pati to nesūta. Atveriet Nosūtītie ziņojumi, lai tā vietā izmantotu pašvaldības vietni."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pranešimas išsaugotas telefone. Fixa šiuo metu pati jo nesiunčia. Atidarykite Išsiųsti pranešimai ir naudokitės savivaldybės svetaine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bejelentése el van mentve a telefonon. A Fixa most nem küld magától. Nyissa meg az Elküldött bejelentéseket, és használja inkább a község weboldalát."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je melding is op deze telefoon bewaard. Fixa verstuurt nu niets uit zichzelf. Open Verstuurde meldingen om in plaats daarvan de website van de gemeente te gebruiken."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen din er lagret på telefonen. Fixa sender ikke av seg selv akkurat nå. Åpne Sendte meldinger for å bruke kommunens nettsted i stedet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłoszenie jest zapisane w telefonie. Fixa nie wysyła teraz sama. Otwórz Wysłane zgłoszenia, aby zamiast tego skorzystać ze strony gminy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua participação está guardada neste telemóvel. O Fixa não está a enviar sozinho de momento. Abra Participações enviadas para usar antes o site do município."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesizarea este salvată pe telefon. Fixa nu trimite singură acum. Deschideți Sesizări trimise ca să folosiți în schimb site-ul comunei."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoituksesi on tallessa puhelimessa. Fixa ei lähetä nyt itsestään. Avaa Lähetetyt ilmoitukset ja käytä sen sijaan kunnan verkkosivua."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναφορά σας είναι αποθηκευμένη στο τηλέφωνο. Το Fixa δεν στέλνει μόνο του αυτή τη στιγμή. Ανοίξτε τις Απεσταλμένες αναφορές για να χρησιμοποιήσετε τον ιστότοπο του δήμου."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщение сохранено на телефоне. Сейчас Fixa не отправляет его сама. Откройте «Отправленные сообщения», чтобы воспользоваться сайтом коммуны."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомлення збережене на телефоні. Зараз Fixa не надсилає його сама. Відкрийте «Надіслані повідомлення», щоб скористатися сайтом комуни."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلاغك محفوظ على هذا الهاتف. لا يرسل Fixa تلقائيًا الآن. افتح البلاغات المرسلة لاستخدام موقع البلدية بدلًا من ذلك."
          }
        }
      }
    },
    "You reported this here on %@ (case %@). Send it again?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You reported this here on %@ (case %@). Send it again?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du anmälde detta här den %@ (ärende %@). Skicka igen?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle jste tu nahlásili %@ (případ %@). Odeslat znovu?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du indberettede dette her den %@ (sag %@). Send igen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das hier am %@ gemeldet (Vorgang %@). Erneut senden?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teatasite sellest siin %@ (juhtum %@). Saata uuesti?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisaste de esto aquí el %@ (expediente %@). ¿Enviarlo de nuevo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez signalé ceci ici le %@ (dossier %@). L'envoyer à nouveau ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai segnalato questo qui il %@ (pratica %@). Inviarlo di nuovo?"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs par šo ziņojāt šeit %@ (lieta %@). Sūtīt vēlreiz?"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apie tai čia pranešėte %@ (byla %@). Siųsti dar kartą?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt itt már bejelentette: %@ (ügyszám: %@). Elküldi újra?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt dit hier gemeld op %@ (zaak %@). Opnieuw versturen?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du meldte dette her %@ (sak %@). Sende på nytt?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłosiłeś to tutaj %@ (sprawa %@). Wysłać ponownie?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participou isto aqui a %@ (processo %@). Enviar novamente?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ați sesizat asta aici pe %@ (dosar %@). Trimiteți din nou?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitit tästä täällä %@ (asia %@). Lähetetäänkö uudelleen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αναφέρατε εδώ στις %@ (υπόθεση %@). Να σταλεί ξανά;"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уже сообщали об этом здесь %@ (дело %@). Отправить ещё раз?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви вже повідомляли про це тут %@ (справа %@). Надіслати ще раз?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبلغت عن هذا هنا في %@ (القضية %@). هل تريد إرساله مرة أخرى؟"
          }
        }
      }
    },
