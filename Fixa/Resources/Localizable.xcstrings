    "It disappears from Sent reports in Fixa. The report itself stays with %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيختفي من البلاغات المرسلة في Fixa. أما البلاغ نفسه فيبقى لدى %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmizí ze seznamu Odeslaná hlášení ve Fixe. Samotné hlášení zůstane u %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forsvinder fra Sendte anmeldelser i Fixa. Selve anmeldelsen bliver hos %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verschwindet aus „Gesendete Meldungen“ in Fixa. Die Meldung selbst bleibt bei %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα αφαιρεθεί από τις Απεσταλμένες αναφορές στο Fixa. Η ίδια η αναφορά παραμένει στο %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
