    "Reports to the kommun become public records. Avoid faces, number plates and other people's names." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports to the kommun become public records. Avoid faces, number plates and other people's names."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du skickar till kommunen blir allmän handling och kan lämnas ut. Undvik ansikten, registreringsskyltar och andras namn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlášení obci se stávají veřejnými dokumenty. Vyhněte se obličejům, SPZ a jménům jiných lidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldelser til kommunen bliver offentlige dokumenter. Undgå ansigter, nummerplader og andres navne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldungen an die Gemeinde werden öffentliche Dokumente. Vermeide Gesichter, Kennzeichen und Namen anderer Menschen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vallale saadetud teated muutuvad avalikeks dokumentideks. Väldi nägusid, numbrimärke ja teiste inimeste nimesid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos al municipio pasan a ser documentos públicos. Evita caras, matrículas y nombres de otras personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signalements à la commune deviennent des documents publics. Évite les visages, les plaques d’immatriculation et les noms d’autres personnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le segnalazioni al comune diventano atti pubblici. Evita volti, targhe e nomi di altre persone."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziņojumi pašvaldībai kļūst par publiskiem dokumentiem. Izvairies no sejām, numurzīmēm un citu cilvēku vārdiem."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pranešimai savivaldybei tampa viešais dokumentais. Venkite veidų, automobilių numerių ir kitų žmonių vardų."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az önkormányzatnak küldött bejelentések nyilvános iratok lesznek. Kerüld az arcokat, rendszámokat és mások nevét."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen aan de gemeente worden openbare documenten. Vermijd gezichten, kentekens en namen van anderen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldinger til kommunen blir offentlige dokumenter. Unngå ansikter, bilskilt og andres navn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłoszenia do gminy stają się dokumentami publicznymi. Unikaj twarzy, tablic rejestracyjnych i nazwisk innych osób."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As participações ao município tornam-se documentos públicos. Evita rostos, matrículas e nomes de outras pessoas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesizările către primărie devin documente publice. Evită fețele, numerele de înmatriculare și numele altor oameni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunnalle lähetetyistä ilmoituksista tulee julkisia asiakirjoja. Vältä kasvoja, rekisterikilpiä ja muiden ihmisten nimiä."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αναφορές προς τον δήμο γίνονται δημόσια έγγραφα. Απόφυγε πρόσωπα, πινακίδες κυκλοφορίας και ονόματα άλλων."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения в коммуну становятся публичными документами. Избегайте лиц, номерных знаков и имён других людей."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомлення до комуни стають публічними документами. Уникайте облич, номерних знаків та імен інших людей."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصبح البلاغات المرسلة إلى البلدية وثائق عامة. تجنّب الوجوه ولوحات السيارات وأسماء الآخرين."
          }
        }
      }
    },
