    "Your report is saved on this phone. Fixa sends it when you're back online, also in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلاغك محفوظ على هذا الهاتف. سيرسله Fixa عند عودتك إلى الإنترنت، حتى في الخلفية."
          }
        },
        "cs" : {
