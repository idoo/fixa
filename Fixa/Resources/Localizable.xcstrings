    },
    "Your report goes straight to the municipality's own fault-report service, just like the website." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report goes straight to the municipality's own fault-report service, just like the website."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din anmälan går direkt till kommunens egen felanmälan, precis som på webbplatsen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoituksesi menee suoraan kunnan omaan vikailmoituspalveluun, aivan kuten verkkosivulla."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذهب بلاغك مباشرة إلى خدمة البلاغات الخاصة بالبلدية، تمامًا كما في الموقع الإلكتروني."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше звернення йде просто до власної служби звернень муніципалітету, так само як на сайті."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje zgłoszenie trafia prosto do własnej usługi zgłaszania usterek gminy, tak jak na stronie internetowej."
          }
        }
      }
    },
