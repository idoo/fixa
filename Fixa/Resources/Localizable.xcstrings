    "Deep pothole in the cycle lane, easy to miss in the dark." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حفرة عميقة في مسار الدراجات، يصعب رؤيتها في الظلام."
