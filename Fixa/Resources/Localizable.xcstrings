        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea s-a întrerupt exact când se trimitea sesizarea, așa că Fixa nu a primit o confirmare. Este foarte posibil să fi ajuns la %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение прервалось в момент отправки, поэтому Fixa не получила подтверждения. Вполне возможно, что заявка дошла до %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen bröts precis när anmälan skickades, så Fixa såg ingen bekräftelse. Den kan mycket väl ha kommit fram till %@."
