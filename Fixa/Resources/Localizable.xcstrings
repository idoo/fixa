    "For example: the light by the bus stop has been out since Monday. Write in any language." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثلًا: المصباح عند موقف الحافلات مطفأ منذ يوم الاثنين. اكتب بأي لغة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Například: světlo u autobusové zastávky nesvítí od pondělí. Pište v jakémkoli jazyce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For eksempel: lampen ved busstoppestedet har været slukket siden mandag. Skriv på det sprog, du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Beispiel: Die Lampe an der Bushaltestelle ist seit Montag aus. Schreiben Sie in einer beliebigen Sprache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για παράδειγμα: η λάμπα δίπλα στη στάση του λεωφορείου είναι σβηστή από τη Δευτέρα. Γράψτε σε όποια γλώσσα θέλετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For example: the light by the bus stop has been out since Monday. Write in any language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ejemplo: la farola junto a la parada de autobús está apagada desde el lunes. Escribe en el idioma que quieras."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näiteks: bussipeatuse juures olev lamp on esmaspäevast saati kustunud. Võite kirjutada mis tahes keeles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esimerkiksi: bussipysäkin valo on ollut pimeänä maanantaista asti. Voit kirjoittaa millä kielellä tahansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par exemple : le lampadaire près de l’arrêt de bus est éteint depuis lundi. Écrivez dans la langue de votre choix."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Például: a buszmegálló melletti lámpa hétfő óta nem ég. Bármilyen nyelven írhat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per esempio: il lampione vicino alla fermata dell'autobus è spento da lunedì. Scrivi in qualsiasi lingua."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pavyzdžiui: šviestuvas prie autobusų stotelės nešviečia nuo pirmadienio. Rašykite bet kuria kalba."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piemēram: lampa pie autobusa pieturas nedeg kopš pirmdienas. Rakstiet jebkurā valodā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For eksempel: lyset ved bussholdeplassen har vært slukket siden mandag. Skriv på hvilket språk du vil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijvoorbeeld: de lamp bij de bushalte is sinds maandag uit. Je mag in elke taal schrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na przykład: lampa przy przystanku nie świeci od poniedziałku. Pisz w dowolnym języku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por exemplo: o candeeiro junto à paragem de autocarro está apagado desde segunda-feira. Escreva em qualquer idioma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De exemplu: lampa de lângă stația de autobuz nu mai merge de luni. Puteți scrie în orice limbă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Например: фонарь у автобусной остановки не горит с понедельника. Пишите на любом языке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Till exempel: lampan vid busshållplatsen har varit släckt sedan i måndags. Skriv på vilket språk du vill."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наприклад: ліхтар біля зупинки не світить з понеділка. Пишіть будь-якою мовою."
          }
        }
      }
    },
