    "Reports already sent belong to %@; ask them to change or delete one. Reports sent by e-mail also stay in your Mail app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البلاغات المُرسلة بالفعل تخص %@؛ اطلب منهم تعديل بلاغ أو حذفه. البلاغات المُرسلة بالبريد الإلكتروني تبقى أيضًا في تطبيق البريد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Již odeslaná hlášení patří %@; o jejich změnu nebo smazání požádejte tam. Hlášení odeslaná e-mailem zůstávají také ve vaší aplikaci Mail."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldelser, der allerede er sendt, tilhører %@. Bed dem om at ændre eller slette en. Anmeldelser sendt via e-mail ligger også stadig i din Mail-app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits gesendete Meldungen liegen bei %@. Bitten Sie dort darum, eine Meldung zu ändern oder zu löschen. Per E-Mail gesendete Meldungen bleiben auch in Ihrer Mail-App."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αναφορές που έχουν ήδη σταλεί ανήκουν στο %@. Ζητήστε από αυτό να αλλάξει ή να διαγράψει κάποια. Οι αναφορές που στάλθηκαν μέσω email παραμένουν επίσης στην εφαρμογή Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports already sent belong to %@; ask them to change or delete one. Reports sent by e-mail also stay in your Mail app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos ya enviados pertenecen a %@. Pídeles que cambien o eliminen alguno. Los avisos enviados por correo electrónico también se quedan en tu app Mail."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juba saadetud teated kuuluvad asutusele %@; muutmiseks või kustutamiseks pöörduge nende poole. E-postiga saadetud teated jäävad ka teie rakendusse Mail."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo lähetetyt ilmoitukset kuuluvat kohteelle %@; pyydä heitä muuttamaan tai poistamaan ilmoitus. Sähköpostilla lähetetyt ilmoitukset jäävät myös Mail-sovellukseesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signalements déjà envoyés appartiennent à %@ ; contactez-la pour en modifier ou en supprimer un. Les signalements envoyés par e-mail restent aussi dans votre app Mail."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A már elküldött bejelentések a következőhöz tartoznak: %@. Módosításhoz vagy törléshez forduljon hozzájuk. Az e-mailben küldött bejelentések a Mail alkalmazásban is megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le segnalazioni già inviate appartengono a %@; chiedi a loro di modificarne o eliminarne una. Le segnalazioni inviate via e-mail restano anche nell'app Mail."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jau išsiųsti pranešimai priklauso %@; norėdami ką nors pakeisti ar ištrinti, kreipkitės į juos. El. paštu išsiųsti pranešimai taip pat lieka jūsų programoje „Mail“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jau nosūtītie ziņojumi pieder %@. Lai kādu mainītu vai dzēstu, sazinieties ar pašvaldību. Pa e-pastu nosūtītie ziņojumi paliek arī jūsu lietotnē Mail."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldinger som allerede er sendt, tilhører %@. Be dem endre eller slette en melding. Meldinger sendt på e-post ligger også i Mail-appen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen die al verstuurd zijn, horen bij %@. Vraag hen om een melding te wijzigen of te verwijderen. Meldingen die per e-mail zijn verstuurd, blijven ook in je Mail-app staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłoszenia już wysłane należą do: %@; poproś ich o zmianę lub usunięcie zgłoszenia. Zgłoszenia wysłane e-mailem zostają też w Twojej aplikacji Mail."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As participações já enviadas pertencem a %@; peça-lhes para alterar ou eliminar alguma. As participações enviadas por e-mail ficam também na sua app Mail."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesizările deja trimise sunt gestionate de %@; cereți-le să modifice sau să șteargă una. Sesizările trimise prin e-mail rămân și în aplicația Mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже отправленные заявки находятся в %@. Чтобы изменить или удалить заявку, обратитесь туда. Заявки, отправленные по электронной почте, также остаются в приложении «Почта»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmälningar som redan skickats tillhör %@; be dem ändra eller ta bort en. Anmälningar skickade med e-post finns också kvar i din e-postapp."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже надіслані звернення належать %@; попросіть їх змінити чи видалити звернення. Звернення, надіслані електронною поштою, також залишаються у вашій поштовій програмі."
          }
        }
      }
    },
