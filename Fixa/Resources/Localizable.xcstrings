            "value" : "Hluboký výmol v cyklopruhu, ve tmě snadno přehlédnutelný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dybt hul i cykelstien, let at overse i mørke."
