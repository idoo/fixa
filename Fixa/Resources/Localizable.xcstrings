    "Used only for the report you're writing, then forgotten." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم فقط للبلاغ الذي تكتبه الآن، ثم تُنسى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použije se jen pro hlášení, které právě píšete, a pak se zapomene."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges kun til den anmeldelse, du skriver, og glemmes derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur für die aktuelle Meldung verwendet und danach vergessen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται μόνο για την αναφορά που γράφετε και μετά διαγράφεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only for the report you're writing, then forgotten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se usa para el aviso que estás escribiendo y luego se olvida."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasutatakse ainult praegu kirjutatava teate jaoks ja unustatakse seejärel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään vain nyt kirjoittamaasi ilmoitukseen, sitten unohdetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée uniquement pour le signalement en cours, puis oubliée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak az éppen írt bejelentéshez használjuk, utána elfelejtjük."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usata solo per la segnalazione che stai scrivendo, poi dimenticata."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudojama tik rašomam pranešimui, paskui pamirštama."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek izmantota tikai ziņojumam, ko rakstāt, un pēc tam aizmirsta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes bare til meldingen du skriver nå, og glemmes så."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen gebruikt voor de melding die je nu schrijft, daarna vergeten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane tylko w zgłoszeniu, które piszesz, potem zapominane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usada apenas para a participação que está a escrever e depois esquecida."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosită doar pentru sesizarea pe care o scrieți, apoi uitată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется только для текущей заявки, затем забывается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används bara för anmälan du skriver nu och glöms sedan bort."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуються лише для поточного повідомлення, потім забуваються."
          }
        }
      }
    },
