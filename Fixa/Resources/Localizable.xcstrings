        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš iPhone sdílí jen přibližnou polohu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din iPhone deler kun en omtrentlig placering"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
