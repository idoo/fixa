        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värmdö valla e-teenus nõuab nüüd sisselogimist. Kasutage valla veebisaiti."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
