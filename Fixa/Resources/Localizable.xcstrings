    "For example: the light by the bus stop has been out since Monday. Write in any language." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For example: the light by the bus stop has been out since Monday. Write in any language."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Till exempel: lampan vid busshållplatsen har varit släckt sedan i måndags. Skriv på vilket språk du vill."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esimerkiksi: bussipysäkin valo on ollut pimeänä maanantaista asti. Voit kirjoittaa millä kielellä tahansa."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثلًا: المصباح عند موقف الحافلات مطفأ منذ يوم الاثنين. اكتب بأي لغة."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наприклад: ліхтар біля зупинки не світить з понеділка. Пишіть будь-якою мовою."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na przykład: lampa przy przystanku nie świeci od poniedziałku. Pisz w dowolnym języku."
          }
        }
      }
    },
