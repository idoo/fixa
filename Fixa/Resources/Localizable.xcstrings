    "No account, no server. Your data stays on this phone, and photos lose their location." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا حساب ولا خادم. تبقى بياناتك على هذا الهاتف، وتُزال المواقع من الصور."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný účet, žádný server. Vaše údaje zůstávají v tomto telefonu a fotky neobsahují polohu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen konto, ingen server. Dine data bliver på denne telefon, og billederne mister deres placering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, kein Server. Ihre Daten bleiben auf diesem Telefon, und Fotos verlieren ihre Ortsangabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς λογαριασμό, χωρίς διακομιστή. Τα δεδομένα σας μένουν σε αυτό το τηλέφωνο και οι φωτογραφίες δεν περιέχουν τοποθεσία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account, no server. Your data stays on this phone, and photos lose their location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta ni servidor. Tus datos se quedan en este teléfono y las fotos pierden su ubicación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontot ega serverit pole. Teie andmed jäävad sellesse telefoni ja fotodelt eemaldatakse asukoht."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tiliä, ei palvelinta. Tietosi pysyvät puhelimessa, ja kuvista poistetaan sijainti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte, pas de serveur. Vos données restent sur ce téléphone, et les photos perdent leur position."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs fiók, nincs szerver. Az adatai ezen a telefonon maradnak, a fényképekről pedig törlődik a helyadat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account, nessun server. I tuoi dati restano su questo telefono e le foto perdono la posizione."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokios paskyros, jokio serverio. Jūsų duomenys lieka šiame telefone, o nuotraukose nelieka vietos duomenų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez konta, bez servera. Jūsu dati paliek šajā tālrunī, un fotoattēliem tiek noņemta atrašanās vieta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen konto, ingen server. Dataene dine blir på denne telefonen, og bildene mister posisjonen sin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen account, geen server. Je gegevens blijven op deze telefoon en foto's verliezen hun locatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez konta i serwera. Dane zostają w telefonie, a zdjęcia tracą lokalizację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem servidor. Os seus dados ficam neste telemóvel e as fotografias perdem a localização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fără cont, fără server. Datele dumneavoastră rămân pe acest telefon, iar fotografiile nu păstrează locația."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без учётной записи и без сервера. Ваши данные остаются на этом телефоне, а из фото удаляется местоположение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget konto, ingen server. Dina uppgifter stannar i telefonen och bilderna saknar plats."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без акаунта й сервера. Дані лишаються на телефоні, а з фото прибирається місце."
          }
        }
      }
    },
