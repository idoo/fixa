    "Fixa has no account, server or statistics. Photos lose their location before they are sent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد في Fixa حساب ولا خادم ولا إحصاءات. تُزال المواقع من الصور قبل إرسالها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa nemá účet, server ani statistiky. Fotografie před odesláním přijdou o údaje o poloze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa har ingen konto, ingen server og ingen statistik. Billederne mister deres placering, før de sendes."
