        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba zgłoszeń usuwanych z tego telefonu razem z numerami spraw: %lld. %@ nadal je ma."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld participações são removidas deste telemóvel, com os respetivos números de processo. %@ continua a tê-las."
