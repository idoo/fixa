    "Fixa adds this Swedish summary so the municipality understands." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa adds this Swedish summary so the municipality understands."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa lägger till den här sammanfattningen på svenska så att kommunen förstår."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa lisää tämän ruotsinkielisen yhteenvedon, jotta kunta ymmärtää."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف Fixa هذا الملخص بالسويدية لكي تفهمه البلدية."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
