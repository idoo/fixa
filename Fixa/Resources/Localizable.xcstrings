    "If the first one arrived, %@ gets the same report twice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا وصل البلاغ الأول، فستتلقى %@ البلاغ نفسه مرتين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud první hlášení dorazilo, %@ dostane stejné hlášení dvakrát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis den første kom frem, får %@ den samme anmeldelse to gange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die erste Meldung angekommen ist, erhält %@ dieselbe Meldung zweimal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η πρώτη έφτασε, το %@ θα λάβει την ίδια αναφορά δύο φορές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the first one arrived, %@ gets the same report twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el primero llegó, %@ recibirá el mismo aviso dos veces."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui esimene teade jõudis kohale, saab %@ sama teate kaks korda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos ensimmäinen meni perille, %@ saa saman ilmoituksen kahdesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le premier est arrivé, %@ recevra deux fois le même signalement."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az első megérkezett, a(z) %@ kétszer kapja meg ugyanazt a bejelentést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la prima è arrivata, %@ riceverà la stessa segnalazione due volte."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei pirmasis pranešimas buvo gautas, %@ gaus tą patį pranešimą du kartus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja pirmais ziņojums nonāca galā, %@ saņems to pašu ziņojumu divreiz."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis den første kom fram, får %@ den samme meldingen to ganger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de eerste is aangekomen, krijgt %@ dezelfde melding twee keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli pierwsze dotarło, %@ dostanie to samo zgłoszenie dwa razy."
          }
        },
        "pt" : {
          "stringUnit" : {
