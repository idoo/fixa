{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld reports are removed from this phone, with their case numbers. %@ still has them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld reports are removed from this phone, with their case numbers. %@ still has them."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld anmälningar tas bort från telefonen, med sina ärendenummer. %@ har dem kvar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ilmoitusta poistetaan tästä puhelimesta asianumeroineen. %@ säilyttää ne."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد البلاغات التي ستُحذف من هذا الهاتف مع أرقام قضاياها: %lld. تبقى لدى %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звернень, які буде видалено з цього телефона разом із номерами справ: %lld. У %@ вони залишаться."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba zgłoszeń usuwanych z tego telefonu razem z numerami spraw: %lld. %@ nadal je ma."
          }
        }
      }
    },
    "1 report is removed from this phone, with its case number. %@ still has it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 report is removed from this phone, with its case number. %@ still has it."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 anmälan tas bort från telefonen, med sitt ärendenummer. %@ har den kvar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 ilmoitus poistetaan tästä puhelimesta asianumeroineen. %@ säilyttää sen."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف بلاغ واحد من هذا الهاتف مع رقم قضيته. يبقى لدى %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 звернення буде видалено з цього телефона разом із номером справи. У %@ воно залишиться."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 zgłoszenie zostanie usunięte z tego telefonu razem z numerem sprawy. %@ nadal je ma."
          }
        }
      }
    },
