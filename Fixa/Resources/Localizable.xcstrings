    "Everything stays on your phone: your details, drafts and the reports you've sent. No account, no server, no tracking." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء يبقى على هاتفك: بياناتك ومسوداتك والبلاغات التي أرسلتها. بلا حساب، بلا خادم، بلا تتبّع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechno zůstává ve vašem telefonu: vaše údaje, koncepty i odeslaná hlášení. Žádný účet, žádný server, žádné sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt bliver på din telefon: dine oplysninger, kladder og de anmeldelser, du har sendt. Ingen konto, ingen server, ingen sporing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf deinem Handy: deine Angaben, Entwürfe und gesendeten Meldungen. Kein Konto, kein Server, kein Tracking."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα μένουν στο τηλέφωνό σου: τα στοιχεία σου, τα πρόχειρα και οι αναφορές που έστειλες. Χωρίς λογαριασμό, χωρίς διακομιστή, χωρίς παρακολούθηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays on your phone: your details, drafts and the reports you've sent. No account, no server, no tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se queda en tu teléfono: tus datos, borradores y los avisos que has enviado. Sin cuenta, sin servidor, sin rastreo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik jääb sinu telefoni: sinu andmed, mustandid ja saadetud teated. Kontot pole, serverit pole, jälgimist pole."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki pysyy puhelimessasi: tietosi, luonnokset ja lähettämäsi ilmoitukset. Ei tiliä, ei palvelinta, ei seurantaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste sur votre téléphone : vos coordonnées, vos brouillons et les signalements envoyés. Pas de compte, pas de serveur, pas de pistage."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden a telefonodon marad: az adataid, a piszkozatok és az elküldött bejelentések. Nincs fiók, nincs szerver, nincs követés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta sul tuo telefono: i tuoi dati, le bozze e le segnalazioni inviate. Nessun account, nessun server, nessun tracciamento."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viskas lieka jūsų telefone: jūsų duomenys, juodraščiai ir išsiųsti pranešimai. Jokios paskyros, jokio serverio, jokio sekimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viss paliek tavā tālrunī: tavi dati, melnraksti un nosūtītie ziņojumi. Bez konta, bez servera, bez izsekošanas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt blir på telefonen din: opplysningene dine, utkast og meldingene du har sendt. Ingen konto, ingen server, ingen sporing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft op je telefoon: je gegevens, concepten en de meldingen die je hebt verstuurd. Geen account, geen server, geen tracking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko zostaje w twoim telefonie: twoje dane, szkice i wysłane zgłoszenia. Bez konta, bez serwera, bez śledzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica no seu telemóvel: os seus dados, rascunhos e as participações que enviou. Sem conta, sem servidor, sem rastreio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totul rămâne pe telefonul tău: datele tale, ciornele și sesizările trimise. Fără cont, fără server, fără urmărire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся на вашем телефоне: ваши данные, черновики и отправленные заявки. Без аккаунта, без сервера, без слежки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt stannar i din telefon: dina uppgifter, utkast och anmälningar du har skickat. Inget konto, ingen server, ingen spårning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе залишається на вашому телефоні: ваші дані, чернетки й надіслані заявки. Без акаунта, без сервера, без стеження."
          }
        }
      }
    },
