    "Optional. Only used when you ask for a reply, for the report you're writing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Only used when you ask for a reply, for the report you're writing."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frivilligt. Används bara när du vill ha svar, för anmälan du skriver nu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapaaehtoinen. Käytetään vain, kun pyydät vastausta, nyt kirjoittamaasi ilmoitukseen."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختياري. تُستخدم فقط عندما تطلب ردًا، للبلاغ الذي تكتبه الآن."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необов'язково. Використовуються лише, коли ви просите відповідь, для поточного повідомлення."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne. Używane tylko, gdy prosisz o odpowiedź, w zgłoszeniu, które piszesz."
          }
        }
      }
    },
    "Optional. Only used when you ask for a reply. Saved on this phone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
