    "Sent as written. Enough on its own if you don't put a pin on the map." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسَل كما كتبته. يكفي وحده إن لم تضع دبوساً على الخريطة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odešle se tak, jak to napíšete. Stačí i bez špendlíku na mapě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendes, som du skriver det. Er nok i sig selv, hvis du ikke sætter en nål på kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird so gesendet, wie Sie es schreiben. Reicht auch ohne Stecknadel auf der Karte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στέλνεται όπως το γράψατε. Αρκεί και χωρίς καρφίτσα στον χάρτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent as written. Enough on its own if you don't put a pin on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía tal como lo escribes. Basta por sí solo si no pones un pin en el mapa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saadetakse nii, nagu kirjutate. Piisab ka ilma kaardinõelata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetetään sellaisenaan. Riittää yksinään, jos et laita nastaa kartalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé tel que vous l'écrivez. Suffit à lui seul si vous ne placez pas d'épingle sur la carte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úgy küldjük el, ahogy írja. Térképtű nélkül is elég."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato così come lo scrivi. Basta da solo se non metti uno spillo sulla mappa."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siunčiama taip, kaip parašėte. Užtenka ir be smeigtuko žemėlapyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiek nosūtīts, kā uzrakstīts. Pietiek arī bez spraudītes kartē."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendes slik du skriver det. Holder alene hvis du ikke setter en nål på kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt verstuurd zoals je het schrijft. Genoeg op zichzelf als je geen speld op de kaart zet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłane tak, jak napiszesz. Wystarczy samo, jeśli nie wstawisz pinezki na mapie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado tal como escreve. Basta por si só se não colocar um alfinete no mapa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se trimite așa cum scrieți. Ajunge și fără un pin pe hartă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляется как написано. Достаточно и без булавки на карте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickas som du skriver. Räcker även utan nål på kartan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилається як написано. Достатньо й без шпильки на мапі."
          }
        }
      }
    },
