        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs víz, visszafolyik a szennyvíz vagy elárasztás van? Hívjon most"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen water, riool dat terugloopt of wateroverlast? Bel nu"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke vann, kloakk som renner over eller oversvømmelse? Ring nå"
