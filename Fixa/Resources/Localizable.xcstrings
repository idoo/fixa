    "They pass it to the right team and reply by e-mail." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيحوّلونه إلى الفريق المختص ويردّون عبر البريد الإلكتروني."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předají ho správnému oddělení a odpoví e-mailem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sender den videre til den rette afdeling og svarer på e-mail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie leitet sie an die zuständige Abteilung weiter und antwortet per E-Mail."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τη στέλνουν στο σωστό τμήμα και απαντούν με email."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They pass it to the right team and reply by e-mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo envían al equipo adecuado y responden por correo electrónico."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nad edastavad selle õigele osakonnale ja vastavad e-posti teel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunta välittää sen oikealle tiimille ja vastaa sähköpostilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle le transmet au bon service et vous répond par e-mail."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Továbbítják az illetékes csoportnak, és e-mailben válaszolnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La inoltrano all'ufficio giusto e rispondono via e-mail."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savivaldybė jį perduoda atsakingam skyriui ir atsako el. paštu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pašvaldība to nodod atbildīgajai nodaļai un atbild pa e-pastu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gir den videre til riktig avdeling og svarer på e-post."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zij sturen de melding door naar de juiste afdeling en antwoorden per e-mail."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekażą je właściwemu zespołowi i odpowiedzą e-mailem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaminham-na para a equipa certa e respondem por e-mail."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O trimit echipei potrivite și răspund prin e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коммуна передаст её нужному отделу и ответит по электронной почте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De skickar den till rätt avdelning och svarar via e-post."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його передадуть потрібній службі й дадуть відповідь електронною поштою."
          }
        }
      }
    },
