    "Fixa tried a few times and couldn't get it through. Try again now, or use the kommun's website." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa tried a few times and couldn't get it through. Try again now, or use the kommun's website."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa försökte några gånger men fick inte fram den. Försök igen nu eller använd kommunens webbplats."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa to několikrát zkusila, ale neprošlo to. Zkuste to znovu, nebo použijte web obce."
