          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Ubicación exacta en Ajustes o mueve el mapa manualmente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lülitage seadetes sisse Täpne asukoht või liigutage kaarti ise."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
