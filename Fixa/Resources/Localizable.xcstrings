    "Map. Move the map so the problem is under the centre mark." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خريطة. حرّك الخريطة حتى تصبح المشكلة تحت العلامة في الوسط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Posuňte mapu tak, aby byl problém pod značkou uprostřed."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kort. Flyt kortet, så problemet er under markeringen i midten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte. Verschieben Sie die Karte, sodass das Problem unter der Markierung in der Mitte liegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χάρτης. Μετακινήστε τον χάρτη ώστε το πρόβλημα να βρίσκεται κάτω από το σημάδι στο κέντρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Map. Move the map so the problem is under the centre mark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Mueve el mapa para que el problema quede bajo la marca central."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaart. Liigutage kaarti nii, et probleem jääks keskmise märgi alla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartta. Siirrä karttaa niin, että ongelma on keskellä olevan merkin alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte. Déplacez la carte pour placer le problème sous le repère central."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Térkép. Mozgassa a térképet úgy, hogy a probléma a középső jelölés alá kerüljön."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa. Sposta la mappa in modo che il problema si trovi sotto il segno al centro."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žemėlapis. Pastumkite žemėlapį, kad problema būtų po žyma centre."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte. Pārvietojiet karti, lai problēma būtu zem atzīmes centrā."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kart. Flytt kartet slik at problemet havner under merket i midten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaart. Verschuif de kaart zodat het probleem onder de markering in het midden staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Przesuń mapę tak, aby problem był pod znacznikiem na środku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Mova o mapa para que o problema fique sob a marca central."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartă. Mutați harta astfel încât problema să fie sub marcajul din centru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта. Передвиньте карту так, чтобы проблема оказалась под меткой в центре."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta. Flytta kartan så att problemet hamnar under markeringen i mitten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мапа. Посуньте мапу так, щоб проблема була під позначкою в центрі."
          }
        }
