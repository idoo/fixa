    "Fixa didn't see a confirmation, but it may well have arrived. Check your e-mail for a confirmation before you send it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يرَ Fixa أي تأكيد، لكن ربما وصل البلاغ فعلًا. تحقق من بريدك الإلكتروني بحثًا عن تأكيد قبل أن ترسله مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa nedostala potvrzení, ale hlášení klidně mohlo dorazit. Než ho odešlete znovu, podívejte se do e-mailu, zda nepřišlo potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa fik ingen bekræftelse, men anmeldelsen kan sagtens være nået frem. Se efter en bekræftelse i din e-mail, før du sender den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa hat keine Bestätigung erhalten, aber die Meldung ist möglicherweise trotzdem angekommen. Sehen Sie in Ihren E-Mails nach einer Bestätigung, bevor Sie sie erneut senden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Fixa δεν είδε επιβεβαίωση, αλλά είναι πολύ πιθανό να έφτασε. Ελέγξτε το email σας για επιβεβαίωση πριν τη στείλετε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa didn't see a confirmation, but it may well have arrived. Check your e-mail for a confirmation before you send it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa no recibió confirmación, pero es muy posible que haya llegado. Busca una confirmación en tu correo electrónico antes de volver a enviarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa ei näinud kinnitust, kuid teade võis vabalt kohale jõuda. Enne uuesti saatmist vaadake, kas teie e-postile on tulnud kinnitus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa ei nähnyt vahvistusta, mutta ilmoitus on voinut hyvin mennä perille. Katso sähköpostistasi, tuliko vahvistus, ennen kuin lähetät sen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa n'a pas reçu de confirmation, mais il est bien possible que le signalement soit arrivé. Vérifiez si vous avez reçu une confirmation par e-mail avant de le renvoyer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa nem kapott visszaigazolást, de könnyen lehet, hogy a bejelentés megérkezett. Mielőtt újra elküldi, nézze meg, kapott-e visszaigazolást e-mailben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa non ha ricevuto una conferma, ma è possibile che la segnalazione sia arrivata. Controlla se hai ricevuto una conferma via e-mail prima di inviarla di nuovo."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa negavo patvirtinimo, bet labai gali būti, kad pranešimas buvo gautas. Prieš siųsdami dar kartą, patikrinkite, ar el. paštu gavote patvirtinimą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa nesaņēma apstiprinājumu, taču ļoti iespējams, ka ziņojums nonāca galā. Pirms sūtāt vēlreiz, pārbaudiet, vai e-pastā nav saņemts apstiprinājums."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa fikk ingen bekreftelse, men meldingen kan godt ha kommet fram. Se etter en bekreftelse i e-posten din før du sender den igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa heeft geen bevestiging gezien, maar de melding kan best zijn aangekomen. Kijk in je e-mail of er een bevestiging is voordat je hem opnieuw verstuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa nie zobaczył potwierdzenia, ale zgłoszenie mogło dotrzeć. Zanim wyślesz je ponownie, sprawdź, czy w poczcie jest potwierdzenie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fixa não recebeu confirmação, mas é bem possível que tenha chegado. Procure uma confirmação no seu e-mail antes de a enviar novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa nu a primit o confirmare, dar este foarte posibil ca sesizarea să fi ajuns. Verificați dacă ați primit o confirmare pe e-mail înainte să o trimiteți din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa не получила подтверждения, но заявка вполне могла дойти. Прежде чем отправлять ещё раз, проверьте, нет ли подтверждения в вашей электронной почте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa såg ingen bekräftelse, men anmälan kan mycket väl ha kommit fram. Titta efter en bekräftelse i din e-post innan du skickar den igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa не побачив підтвердження, але звернення цілком могло дійти. Перш ніж надсилати ще раз, перевірте, чи прийшло підтвердження на пошту."
          }
        }
      }
    },
