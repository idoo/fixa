            "value" : "خدمة الموقع متوقفة لـ Fixa. يمكنك تفعيلها من الإعدادات، أو اضغط على الخريطة بدلًا من ذلك."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для Fixa вимкнено геолокацію. Увімкніть її в Параметрах або торкніться мапи."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalizacja jest wyłączona dla aplikacji Fixa. Włącz ją w Ustawieniach albo dotknij mapy."
          }
        }
      }
    },
    "Mail isn't set up on this phone. Share or copy the report and send it to %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail isn't set up on this phone. Share or copy the report and send it to %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail är inte inställt på telefonen. Dela eller kopiera anmälan och skicka den till %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail-appia ei ole otettu käyttöön tässä puhelimessa. Jaa tai kopioi ilmoitus ja lähetä se osoitteeseen %@."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق البريد غير مُعدّ على هذا الهاتف. شارك البلاغ أو انسخه وأرسله إلى %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошту на цьому телефоні не налаштовано. Поширте або скопіюйте звернення й надішліть його на %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczta nie jest skonfigurowana na tym telefonie. Udostępnij lub skopiuj zgłoszenie i wyślij je na adres %@."
          }
        }
      }
    },
    "Map. Tap to place the pin where the problem is." : {
      "localizations" : {
