            "state" : "translated",
            "value" : "Neteče voda, vrací se kanalizace nebo je zaplaveno? Volejte hned"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet vand, kloak der løber over eller oversvømmelse? Ring nu"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Wasser, Abwasser staut sich oder Überschwemmung? Jetzt anrufen"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vett pole, kanalisatsioon ajab üle või on üleujutus? Helista kohe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sin agua, el desagüe se desborda o hay una inundación? Llama ahora"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus d'eau, égout qui refoule ou inondation ? Appelez maintenant"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente acqua, fognatura che rigurgita o allagamento? Chiama ora"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav ūdens, kanalizācija plūst atpakaļ vai plūdi? Zvaniet tūlīt"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nėra vandens, kyla nuotekos ar užliejo? Skambinkite dabar"
