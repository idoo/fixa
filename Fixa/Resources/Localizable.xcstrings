          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzählen Sie, was passiert ist. Sie können alles unten vor dem Senden ändern oder löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε μας τι συνέβη. Μπορείτε να αλλάξετε ή να διαγράψετε ό,τι υπάρχει παρακάτω πριν το στείλετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell us what happened. You can change or delete anything below before you send it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntenos qué ha pasado. Puede cambiar o borrar todo lo de abajo antes de enviarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjuta, mis juhtus. Enne saatmist võid kõike allpool muuta või kustutada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro, mitä tapahtui. Voit muuttaa tai poistaa mitä tahansa alta ennen lähettämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-nous ce qui s'est passé. Vous pouvez modifier ou supprimer tout ce qui suit avant l'envoi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írja le, mi történt. Küldés előtt bármit módosíthat vagy törölhet alább."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccontaci cosa è successo. Puoi modificare o cancellare tutto qui sotto prima di inviare."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parašykite, kas nutiko. Prieš siųsdami galite bet ką žemiau pakeisti ar ištrinti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastāstiet, kas notika. Pirms sūtīšanas varat visu zemāk mainīt vai dzēst."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortell hva som skjedde. Du kan endre eller slette alt nedenfor før du sender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel wat er gebeurde. U kunt alles hieronder wijzigen of wissen voordat u verstuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz, co się stało. Przed wysłaniem możesz wszystko poniżej zmienić lub usunąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte-nos o que aconteceu. Pode alterar ou apagar tudo o que está abaixo antes de enviar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spuneți-ne ce s-a întâmplat. Puteți modifica sau șterge orice de mai jos înainte de trimitere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расскажите, что случилось. Перед отправкой можно изменить или удалить всё, что ниже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta vad som hände. Du kan ändra eller ta bort allt nedan innan du skickar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розкажіть, що сталося. Перед надсиланням можна змінити або видалити все, що нижче."
          }
        }
      }
    },
