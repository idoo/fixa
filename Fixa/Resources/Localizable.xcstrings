          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zamknąć Fixa. Zgłoszenie znajdziesz w wysłanych zgłoszeniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode fechar a Fixa. Encontra a participação em Participações enviadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puteți închide Fixa. Găsiți sesizarea la Sesizări trimise."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно закрыть Fixa. Заявка будет в разделе «Отправленные заявки»."
