    "The connection dropped just as the report went out, so Fixa didn't see a confirmation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال لحظة إرسال البلاغ، لذلك لم يرَ Fixa أي تأكيد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení se přerušilo právě při odesílání hlášení, takže Fixa nedostala potvrzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen blev afbrudt, lige da anmeldelsen blev sendt, så Fixa fik ingen bekræftelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung ist genau beim Senden der Meldung abgebrochen, daher hat Fixa keine Bestätigung erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση διακόπηκε τη στιγμή που στελνόταν η αναφορά, οπότε το Fixa δεν είδε επιβεβαίωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection dropped just as the report went out, so Fixa didn't see a confirmation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión se cortó justo cuando se enviaba el aviso, así que Fixa no recibió confirmación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühendus katkes just teate saatmise ajal, seega ei näinud Fixa kinnitust."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys katkesi juuri kun ilmoitus lähti, joten Fixa ei nähnyt vahvistusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été coupée au moment de l'envoi, Fixa n'a donc pas reçu de confirmation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolat éppen a bejelentés elküldésekor szakadt meg, ezért a Fixa nem kapott visszaigazolást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione si è interrotta proprio mentre la segnalazione veniva inviata, quindi Fixa non ha ricevuto una conferma."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryšys nutrūko kaip tik siunčiant pranešimą, todėl Fixa negavo patvirtinimo."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savienojums pārtrūka tieši ziņojuma sūtīšanas brīdī, tāpēc Fixa nesaņēma apstiprinājumu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkoblingen ble brutt akkurat da meldingen ble sendt, så Fixa fikk ingen bekreftelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding viel weg net toen de melding werd verstuurd, dus Fixa heeft geen bevestiging gezien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie zerwało się w chwili wysyłania, więc Fixa nie zobaczył potwierdzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ligação falhou precisamente quando a participação estava a ser enviada, por isso a Fixa não recebeu confirmação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea s-a întrerupt exact când se trimitea sesizarea, așa că Fixa nu a primit o confirmare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение прервалось в момент отправки, поэтому Fixa не получила подтверждения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen bröts precis när anmälan skickades, så Fixa såg ingen bekräftelse."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З’єднання обірвалося саме під час надсилання, тому Fixa не побачив підтвердження."
          }
        }
      }
    },
    "The connection dropped just as the report went out, so Fixa didn't see a confirmation. It may well have reached %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال لحظة إرسال البلاغ، لذلك لم يرَ Fixa أي تأكيد. ربما وصل فعلًا إلى %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení se přerušilo právě při odesílání hlášení, takže Fixa nedostala potvrzení. Hlášení ale klidně mohlo k %@ dorazit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen blev afbrudt, lige da anmeldelsen blev sendt, så Fixa fik ingen bekræftelse. Den kan sagtens være nået frem til %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung ist genau beim Senden der Meldung abgebrochen, daher hat Fixa keine Bestätigung erhalten. Die Meldung ist aber möglicherweise trotzdem bei %@ angekommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση διακόπηκε τη στιγμή που στελνόταν η αναφορά, οπότε το Fixa δεν είδε επιβεβαίωση. Είναι πολύ πιθανό να έφτασε στο %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection dropped just as the report went out, so Fixa didn't see a confirmation. It may well have reached %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión se cortó justo cuando se enviaba el aviso, así que Fixa no recibió confirmación. Es muy posible que haya llegado a %@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühendus katkes just teate saatmise ajal, seega ei näinud Fixa kinnitust. Teade võis vabalt jõuda saajani %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys katkesi juuri kun ilmoitus lähti, joten Fixa ei nähnyt vahvistusta. Se on voinut hyvin mennä perille: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été coupée au moment de l'envoi, Fixa n'a donc pas reçu de confirmation. Il est bien possible que le signalement soit arrivé à %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kapcsolat éppen a bejelentés elküldésekor szakadt meg, ezért a Fixa nem kapott visszaigazolást. Könnyen lehet, hogy megérkezett ide: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione si è interrotta proprio mentre la segnalazione veniva inviata, quindi Fixa non ha ricevuto una conferma. È possibile che sia arrivata a %@."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryšys nutrūko kaip tik siunčiant pranešimą, todėl Fixa negavo patvirtinimo. Labai gali būti, kad jis pasiekė %@."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Savienojums pārtrūka tieši ziņojuma sūtīšanas brīdī, tāpēc Fixa nesaņēma apstiprinājumu. Ļoti iespējams, ka tas tomēr nonāca līdz %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkoblingen ble brutt akkurat da meldingen ble sendt, så Fixa fikk ingen bekreftelse. Den kan godt ha kommet fram til %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding viel weg net toen de melding werd verstuurd, dus Fixa heeft geen bevestiging gezien. Hij kan best bij %@ zijn aangekomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie zerwało się w chwili wysyłania, więc Fixa nie zobaczył potwierdzenia. Zgłoszenie mogło jednak dotrzeć do %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ligação falhou precisamente quando a participação estava a ser enviada, por isso a Fixa não recebeu confirmação. É bem possível que tenha chegado a %@."
          }
