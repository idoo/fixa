        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värmdö község e-szolgáltatása most bejelentkezést kér. Használja a község weboldalát."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De e-dienst van de gemeente Värmdö vraagt nu om in te loggen. Gebruik de website van de gemeente."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värmdö kommunes e-tjeneste ber nå om innlogging. Bruk kommunens nettsted."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-usługa gminy Värmdö wymaga teraz logowania. Skorzystaj ze strony gminy."
