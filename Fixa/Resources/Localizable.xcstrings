    "No account, no server. Your data stays on this phone, and photos lose their location." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account, no server. Your data stays on this phone, and photos lose their location."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget konto, ingen server. Dina uppgifter stannar i telefonen och bilderna saknar plats."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tiliä, ei palvelinta. Tietosi pysyvät puhelimessa, ja kuvista poistetaan sijainti."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا حساب ولا خادم. تبقى بياناتك على هذا الهاتف، وتُزال المواقع من الصور."
