    },
    "Your phone seems to be offline. Your report is saved on this phone, and Fixa sends it when you're back online." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أن هاتفك غير متصل بالإنترنت. بلاغك محفوظ على هذا الهاتف، وسيرسله Fixa عندما تعود متصلًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš telefon je zřejmě offline. Vaše hlášení je uložené v tomto telefonu a Fixa ho odešle, až budete znovu online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din telefon ser ud til at være offline. Din anmeldelse er gemt på denne telefon, og Fixa sender den, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Telefon scheint offline zu sein. Ihre Meldung ist auf diesem Telefon gespeichert, und Fixa sendet sie, sobald Sie wieder online sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το τηλέφωνό σας φαίνεται να είναι εκτός σύνδεσης. Η αναφορά σας είναι αποθηκευμένη σε αυτό το τηλέφωνο και το Fixa θα τη στείλει όταν συνδεθείτε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone seems to be offline. Your report is saved on this phone, and Fixa sends it when you're back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que tu teléfono no tiene conexión. Tu aviso está guardado en este teléfono y Fixa lo enviará cuando vuelvas a tener conexión."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie telefon näib olevat võrguühenduseta. Teie teade on selles telefonis salvestatud ja Fixa saadab selle, kui olete jälle võrgus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puhelin näyttää olevan offline-tilassa. Ilmoituksesi on tallessa tässä puhelimessa, ja Fixa lähettää sen, kun olet taas verkossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre téléphone semble hors ligne. Votre signalement est enregistré sur ce téléphone, et Fixa l'enverra dès que vous serez de nouveau en ligne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úgy tűnik, a telefonnak nincs internetkapcsolata. A bejelentése el van mentve ezen a telefonon, és a Fixa elküldi, amint újra lesz kapcsolat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono sembra offline. La segnalazione è salvata su questo telefono e Fixa la invierà quando sarai di nuovo online."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atrodo, kad jūsų telefonas neprisijungęs prie interneto. Jūsų pranešimas išsaugotas šiame telefone, o Fixa jį išsiųs, kai vėl prisijungsite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šķiet, ka tālrunis nav tiešsaistē. Jūsu ziņojums ir saglabāts šajā tālrunī, un Fixa to nosūtīs, kad būsiet atkal tiešsaistē."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen ser ut til å være uten nett. Meldingen din er lagret på denne telefonen, og Fixa sender den når du er på nett igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je telefoon lijkt offline te zijn. Je melding is bewaard op deze telefoon en Fixa verstuurt hem zodra je weer online bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że telefon jest offline. Twoje zgłoszenie jest zapisane na tym telefonie, a Fixa wyśle je, gdy znów będziesz online."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu telemóvel parece estar sem ligação. A sua participação está guardada neste telemóvel e a Fixa envia-a quando houver novamente ligação à internet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonul pare să fie offline. Sesizarea dumneavoastră este salvată pe acest telefon, iar Fixa o trimite când sunteți din nou online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, ваш телефон не подключён к интернету. Ваша заявка сохранена на этом телефоне, и Fixa отправит её, когда вы снова будете в сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonen verkar vara offline. Din anmälan är sparad på telefonen, och Fixa skickar den när du är uppkopplad igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схоже, телефон без інтернету. Ваше звернення збережено на цьому телефоні, і Fixa надішле його, щойно ви знову будете онлайн."
          }
        }
      }
    },
    "Your report goes straight to the municipality's own fault-report service, just like the website." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذهب بلاغك مباشرة إلى خدمة البلاغات الخاصة بالبلدية، تمامًا كما في الموقع الإلكتروني."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše hlášení jde přímo do vlastní služby obce pro hlášení závad, stejně jako na webu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din anmeldelse går direkte til kommunens egen fejlmeldingstjeneste, ligesom på hjemmesiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Meldung geht direkt an den E-Service der Gemeinde für Störungsmeldungen, genau wie über die Website."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναφορά σας πηγαίνει απευθείας στην υπηρεσία αναφοράς βλαβών του ίδιου του δήμου, όπως και στον ιστότοπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report goes straight to the municipality's own fault-report service, just like the website."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu aviso va directamente al servicio de avisos de incidencias del propio municipio, igual que en la web."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie teade läheb otse omavalitsuse enda rikketeadete teenusesse, täpselt nagu veebisaidil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoituksesi menee suoraan kunnan omaan vikailmoituspalveluun, aivan kuten verkkosivulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre signalement est transmis directement au service en ligne de signalement de la commune, comme sur son site web."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bejelentése közvetlenül az önkormányzat saját hibabejelentő szolgáltatásához kerül, ugyanúgy, mint a weboldalon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua segnalazione arriva direttamente al servizio segnalazioni guasti del comune, proprio come dal sito web."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų pranešimas keliauja tiesiai į pačios savivaldybės gedimų pranešimų paslaugą, kaip ir per svetainę."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu ziņojums nonāk tieši pašvaldības bojājumu pieteikšanas pakalpojumā, tāpat kā tīmekļa vietnē."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen din går rett til kommunens egen feilmeldingstjeneste, akkurat som på nettsiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je melding gaat rechtstreeks naar de eigen meldingsdienst van de gemeente, net als via de website."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje zgłoszenie trafia prosto do własnej usługi zgłaszania usterek gminy, tak jak na stronie internetowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua participação vai diretamente para o serviço de participação de avarias do próprio município, tal como no site."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesizarea dumneavoastră ajunge direct la serviciul de sesizări al comunei, la fel ca pe site."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша заявка попадает прямо в собственную службу коммуны по приёму заявок о неисправностях, так же как через сайт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din anmälan går direkt till kommunens egen felanmälan, precis som på webbplatsen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше звернення йде просто до власної служби звернень муніципалітету, так само як на сайті."
          }
        }
      }
    },
