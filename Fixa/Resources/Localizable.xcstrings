    "Mail isn't set up on this phone. Share or copy the report and send it to %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق البريد غير مُعدّ على هذا الهاتف. شارك البلاغ أو انسخه وأرسله إلى %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošta není v tomto telefonu nastavená. Sdílejte nebo zkopírujte hlášení a pošlete ho na %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail er ikke sat op på denne telefon. Del eller kopier anmeldelsen, og send den til %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail ist auf diesem Telefon nicht eingerichtet. Teilen oder kopieren Sie die Meldung und senden Sie sie an %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Mail δεν έχει ρυθμιστεί σε αυτό το τηλέφωνο. Κοινοποιήστε ή αντιγράψτε την αναφορά και στείλτε τη στο %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail isn't set up on this phone. Share or copy the report and send it to %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail no está configurado en este teléfono. Comparte o copia el aviso y envíalo a %@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail pole selles telefonis seadistatud. Jagage või kopeerige teade ja saatke see aadressile %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail-appia ei ole otettu käyttöön tässä puhelimessa. Jaa tai kopioi ilmoitus ja lähetä se osoitteeseen %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail n’est pas configuré sur ce téléphone. Partagez ou copiez le signalement et envoyez-le à %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mail nincs beállítva ezen a telefonon. Ossza meg vagy másolja ki a bejelentést, és küldje el ide: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail non è configurata su questo telefono. Condividi o copia la segnalazione e inviala a %@."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiame telefone nenustatytas paštas. Bendrinkite arba nukopijuokite pranešimą ir išsiųskite jį adresu %@."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasts šajā tālrunī nav iestatīts. Kopīgojiet vai kopējiet ziņojumu un nosūtiet to uz %@."
          }
        },
        "nb" : {
          "stringUnit" : {
