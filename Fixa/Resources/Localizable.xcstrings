        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galite uždaryti Fixa. Pranešimą rasite skiltyje „Išsiųsti pranešimai“."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varat aizvērt Fixa. Ziņojums būs atrodams sadaļā Nosūtītie ziņojumi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan lukke Fixa. Du finner meldingen under Sendte meldinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
