{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/idoo/fixa/schema/adapter.schema.json",
  "title": "Fixa municipality adapter",
  "type": "object",
  "required": ["specVersion", "id", "municipality", "channel", "categories", "tiles", "validation", "webFormURL", "disclaimer"],
  "additionalProperties": false,
  "properties": {
    "specVersion": { "type": "integer", "minimum": 1, "description": "Adapter format version. Apps skip a remote adapter whose version is newer than they support." },
    "minAppBuild": { "type": "integer", "minimum": 1, "description": "Lowest app build (CFBundleVersion) that can run this adapter. Set only when the engine had to change." },
    "id": { "type": "string", "description": "Reverse-DNS id, e.g. se.varmdo.ksb" },
    "municipality": {
      "type": "object",
      "required": ["name", "countryCode", "region", "geocoderNames"],
      "properties": {
        "name": { "type": "string" },
        "countryCode": { "type": "string", "description": "ISO 3166-1 alpha-2" },
        "geocoderNames": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Names a reverse geocoder gives for the municipality, e.g. [\"Värmdö\", \"Värmdö kommun\"]; a pin in the bounding box but in another municipality is outside." },
        "region": {
          "type": "object",
          "required": ["center", "bbox"],
          "properties": {
            "center": { "$ref": "#/$defs/coordinate" },
            "bbox": {
              "type": "object",
              "required": ["minLatitude", "maxLatitude", "minLongitude", "maxLongitude"],
              "properties": {
                "minLatitude": { "type": "number" },
                "maxLatitude": { "type": "number" },
                "minLongitude": { "type": "number" },
                "maxLongitude": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "required": ["kind", "baseURL", "service", "introPath", "startPath", "nextEventTarget", "sessionLockedMarker", "pages"],
      "properties": {
        "kind": { "type": "string", "enum": ["abou"] },
        "baseURL": { "type": "string", "pattern": "^https://[a-z0-9.-]+/?$", "description": "Plain https origin: no user, port, path or query. A downloaded adapter must keep the bundled adapter's host, kind and service." },
        "service": { "type": "string" },
        "introPath": { "$ref": "#/$defs/path" },
        "startPath": { "$ref": "#/$defs/path" },
        "nextEventTarget": { "type": "string", "description": "__EVENTTARGET of the Next/Slutför button" },
        "sessionLockedMarker": { "type": "string" },
        "completionPostBackMarker": { "type": "string", "description": "Text on the page shown after Slutför that means the browser would now auto-post the form (e.g. Abou's ThankYou page runs __doPostBack('', '') on load to finish processing). While present, Fixa re-posts the form with an empty __EVENTTARGET." },
        "maxCompletionPostBacks": { "type": "integer", "minimum": 0, "maximum": 5, "description": "Upper bound for those re-posts (default 3)." },
        "pages": {
          "type": "array",
          "maxItems": 20,
          "description": "Pages in order; the last one is the summary page whose Next submits the case.",
          "items": {
            "type": "object",
            "required": ["id", "stage", "fields"],
            "properties": {
              "id": { "type": "string", "description": "PageId query value" },
              "stage": { "type": "string", "enum": ["sendingReport", "sendingContact", "confirming"] },
              "fields": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "required": ["role", "key", "control"],
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": ["category", "place", "mapChoice", "mapAnswer", "description", "feedback", "firstName", "lastName", "phone", "email"]
                    },
                    "key": { "type": "string", "description": "Input name ends in $<key>_field$<control>" },
                    "control": { "type": "string" },
                    "yesValue": { "type": "string" },
                    "noValue": { "type": "string" },
                    "type": { "type": "string", "enum": ["select", "radio", "checkbox", "text", "textarea", "hidden"], "description": "HTML control type; a renamed control of the same type may be used when its label matches" },
                    "labels": {
                      "type": "object",
                      "description": "Question texts per language, e.g. {\"sv\": [\"Beskriv felet här\"]}; matched case-, diacritic- and '*'-insensitively when the key is not on the page",
                      "additionalProperties": { "type": "array", "items": { "type": "string" } }
                    },
                    "optionSynonyms": {
                      "type": "object",
                      "description": "Other values or visible texts for a radio option, keyed by yesValue/noValue",
                      "additionalProperties": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          }
        },
        "upload": {
          "type": "object",
          "required": ["pageID", "fieldID", "path", "filePartName", "fileName", "actionPath"],
          "properties": {
            "pageID": { "type": "string" },
            "fieldID": { "type": "string" },
            "path": { "$ref": "#/$defs/path" },
            "filePartName": { "type": "string", "pattern": "^[^\"\\\\/;\\u0000-\\u001f]+$" },
            "fileName": { "type": "string", "pattern": "^[^\"\\\\/;\\u0000-\\u001f]+$" },
            "actionPath": { "$ref": "#/$defs/path" }
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "value", "title"],
        "properties": {
          "id": { "type": "string" },
          "value": { "type": "string", "description": "Exact form value" },
          "synonyms": { "type": "array", "items": { "type": "string" }, "description": "Other option values or visible texts meaning this category, tried after the value and its visible text" },
          "title": { "$ref": "#/$defs/localizedText" }
        }
      }
    },
    "tiles": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "symbol", "categoryID", "title"],
        "properties": {
          "id": { "type": "string" },
          "symbol": { "type": "string", "description": "SF Symbol name" },
          "categoryID": { "type": "string" },
          "title": { "$ref": "#/$defs/localizedText" },
          "swedishSummary": { "type": "string", "description": "First line of the description sent to the municipality. Omit when the category says it all; then the resident's own text must reach validation.descriptionMin by itself." },
          "responsibility": { "$ref": "#/$defs/localizedText", "description": "Short note under the tile on who looks after this problem (e.g. municipal streets vs state or private roads). Omit when the municipality always handles it." },
          "links": {
            "type": "array",
            "maxItems": 50,
            "description": "The municipality's other e-services for things that don't belong here, opened in Safari. https only, on the municipality's own domain.",
            "items": {
              "type": "object",
              "required": ["title", "url"],
              "properties": {
                "title": { "$ref": "#/$defs/localizedText" },
                "url": { "type": "string", "pattern": "^https://" }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["descriptionMin", "descriptionMax", "emailRequiredWhenFeedback", "requireLocation"],
      "properties": {
        "descriptionMin": { "type": "integer" },
        "descriptionMax": { "type": "integer" },
        "emailRequiredWhenFeedback": { "type": "boolean" },
        "requireLocation": { "type": "boolean" }
      }
    },
    "emergency": {
      "type": "object",
      "required": ["contacts", "rules", "defaultContactID", "timeZone", "note"],
      "properties": {
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "phone"],
            "properties": {
              "id": { "type": "string" },
              "title": { "$ref": "#/$defs/localizedText" },
              "phone": { "type": "string" }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["isoWeekdays", "until", "contactID"],
            "description": "Applies on the weekdays from 'from' (default 00:00) until before 'until', local time.",
            "properties": {
              "isoWeekdays": { "type": "array", "items": { "type": "integer", "enum": [1, 2, 3, 4, 5, 6, 7] } },
              "from": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              "until": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              "contactID": { "type": "string" }
            }
          }
        },
        "defaultContactID": { "type": "string" },
        "timeZone": { "type": "string" },
        "note": { "$ref": "#/$defs/localizedText" },
        "holidays": { "type": "string", "enum": ["SE"], "description": "Public-holiday calendar on which no rule applies, so defaultContactID answers. SE: Swedish public holidays plus julafton, nyårsafton and midsommarafton." },
        "infoURL": { "type": "string", "pattern": "^https://", "description": "The municipality's own page for non-urgent questions, shown as 'Other questions?' under the emergency call card and opened in the browser. An https page on the municipality's domain." }
      }
    },
    "webFormURL": { "type": "string", "pattern": "^https://", "description": "The municipality's own web form for this e-service, on the channel's host. Fixa opens it when it cannot send. A downloaded adapter must keep the bundled value." },
    "disclaimer": { "$ref": "#/$defs/localizedText" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^/(?!/)[!#-9;-\\[\\]-~]*$",
      "not": { "pattern": "//" },
      "description": "Path on baseURL's host: starts with one '/', no scheme, '//', ':', backslash or whitespace."
    },
    "coordinate": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number" },
        "longitude": { "type": "number" }
      }
    },
    "localizedText": {
      "type": "object",
      "description": "Language code to text; resolves to the user's language, then en, then sv.",
      "required": ["sv", "en"],
      "additionalProperties": { "type": "string" }
    }
  }
}
